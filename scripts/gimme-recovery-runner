#!/usr/bin/python3
"""Fixed unattended Recovery Schedule orchestration core.

This source is deliberately not installed until the common capture executable is complete.
"""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import time
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any, Callable


EXPECTED_APPS_ROOT = Path("__GIMME_APPS_ROOT__")
NAME = re.compile(r"^[a-z][a-z0-9-]{0,63}$")
FINGERPRINT = re.compile(r"^[a-f0-9]{64}$")
STATUS_KEYS = {
    "schema_version", "deployment", "last_logical_slot", "started_at", "finished_at",
    "outcome", "error_code", "recovery_point_id", "last_verified_recovery_point_id",
    "retention_outcome", "retention_deleted", "retention_remaining",
}
OUTCOMES = {
    "succeeded", "backup_succeeded_retention_failed", "deployment_busy", "policy_stale",
    "credentials_unavailable", "credentials_expired", "destination_unavailable",
    "capture_failed", "verification_failed", "retention_failed", "status_unavailable",
}
AUTHORITY_KEYS = {
    "schema_version", "deployment", "target", "policy_fingerprint", "cadence",
    "calendar", "stable_delay_seconds", "retain_last", "quiesce_wait_seconds",
    "components", "placement", "resources", "destination", "status_identity",
    "valkey_execution",
}


class RunnerFailure(RuntimeError):
    pass


def utc(value: datetime) -> datetime:
    if value.tzinfo is None:
        raise RunnerFailure("status_unavailable")
    return value.astimezone(UTC)


def latest_slot(cadence: dict[str, Any], observed_at: datetime) -> datetime | None:
    observed = utc(observed_at)
    kind = cadence.get("kind")
    if kind == "manual" and set(cadence) == {"kind"}:
        return None
    if kind == "hourly" and set(cadence) == {"kind", "minute"}:
        minute = cadence["minute"]
        if isinstance(minute, bool) or not isinstance(minute, int) or not 0 <= minute <= 59:
            raise RunnerFailure("policy_stale")
        candidate = observed.replace(minute=minute, second=0, microsecond=0)
        return candidate if candidate <= observed else candidate - timedelta(hours=1)
    expected = {"kind", "hour", "minute"}
    if kind == "weekly":
        expected.add("weekday")
    if set(cadence) != expected or kind not in {"daily", "weekly"}:
        raise RunnerFailure("policy_stale")
    hour, minute = cadence["hour"], cadence["minute"]
    if any(isinstance(v, bool) or not isinstance(v, int) for v in (hour, minute)):
        raise RunnerFailure("policy_stale")
    if not 0 <= hour <= 23 or not 0 <= minute <= 59:
        raise RunnerFailure("policy_stale")
    candidate = observed.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if kind == "weekly":
        weekdays = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")
        if cadence["weekday"] not in weekdays:
            raise RunnerFailure("policy_stale")
        candidate -= timedelta(days=(candidate.weekday() - weekdays.index(cadence["weekday"])) % 7)
        return candidate if candidate <= observed else candidate - timedelta(days=7)
    return candidate if candidate <= observed else candidate - timedelta(days=1)


def request_id(deployment: str, policy_fingerprint: str, logical_slot: datetime) -> str:
    if NAME.fullmatch(deployment) is None or FINGERPRINT.fullmatch(policy_fingerprint) is None:
        raise RunnerFailure("policy_stale")
    encoded = (
        f"gimme-scheduled-recovery-v1\0{deployment}\0{policy_fingerprint}\0"
        f"{utc(logical_slot).isoformat()}"
    ).encode()
    digest = hashlib.sha256(encoded).hexdigest()[:20]
    return f"scheduled-{digest}"


def atomic_status(path: Path, document: dict[str, Any]) -> None:
    if (
        set(document) != STATUS_KEYS
        or document["outcome"] not in OUTCOMES
        or document["error_code"] not in OUTCOMES | {None}
        or NAME.fullmatch(str(document["deployment"])) is None
    ):
        raise RunnerFailure("status_unavailable")
    encoded = json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n"
    if len(encoded.encode()) > 16 * 1024:
        raise RunnerFailure("status_unavailable")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w") as handle:
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise


def acquire_lock(
    path: Path, timeout_seconds: int = 300, *, monotonic: Callable[[], float] = time.monotonic,
    pause: Callable[[float], None] = time.sleep,
):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    handle = path.open("a+")
    os.chmod(path, 0o600)
    deadline = monotonic() + timeout_seconds
    while True:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if monotonic() >= deadline:
                handle.close()
                return None
            pause(min(1.0, max(0.0, deadline - monotonic())))


def attempt_status(
    deployment: str, logical_slot: datetime, started_at: datetime, outcome: str,
    *, finished_at: datetime | None = None, error_code: str | None = None,
) -> dict[str, Any]:
    if (
        outcome not in OUTCOMES
        or error_code not in OUTCOMES | {None}
        or NAME.fullmatch(deployment) is None
    ):
        raise RunnerFailure("status_unavailable")
    return {
        "schema_version": 1,
        "deployment": deployment,
        "last_logical_slot": utc(logical_slot).isoformat(),
        "started_at": utc(started_at).isoformat(),
        "finished_at": None if finished_at is None else utc(finished_at).isoformat(),
        "outcome": outcome,
        "error_code": error_code,
        "recovery_point_id": None,
        "last_verified_recovery_point_id": None,
        "retention_outcome": None,
        "retention_deleted": 0,
        "retention_remaining": 0,
    }


def load_credential(path: Path | None, keys: set[str]) -> dict[str, str] | None:
    if path is None:
        return None
    try:
        details = path.stat()
        if (
            path.is_symlink() or not path.is_file() or details.st_mode & 0o077
            or details.st_size > 16 * 1024
        ):
            raise RunnerFailure("credentials_unavailable")
        value = json.loads(path.read_text())
    except RunnerFailure:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError):
        raise RunnerFailure("credentials_unavailable") from None
    if (
        not isinstance(value, dict)
        or set(value) != keys
        or not all(
            isinstance(item, str) and item and "\0" not in item and "\n" not in item
            for item in value.values()
        )
    ):
        raise RunnerFailure("credentials_unavailable")
    return value


def capture_recovery(
    authority: dict[str, Any], scheduled_request: str, directory: Path,
    target_capture: Any, *, aws_credentials: dict[str, str] | None = None,
    valkey_credential_path: Path | None = None, observed_at: datetime | None = None,
) -> dict[str, object]:
    """Execute only the capture policy already validated and fingerprinted by reconciliation."""
    if (
        set(authority) != AUTHORITY_KEYS
        or authority.get("schema_version") != 2
        or not isinstance(authority.get("deployment"), str)
        or NAME.fullmatch(authority["deployment"]) is None
        or authority.get("status_identity") != authority["deployment"]
        or authority.get("components") not in (["postgres"], ["postgres", "valkey"])
        or not isinstance(authority.get("placement"), dict)
        or not isinstance(authority.get("resources"), dict)
        or not isinstance(authority.get("destination"), dict)
    ):
        raise RunnerFailure("policy_stale")
    deployment = authority["deployment"]
    resources = authority["resources"]
    placement = authority["placement"]
    destination = authority["destination"]
    postgres = resources.get("postgres")
    if (
        set(resources) != set(authority["components"])
        or not isinstance(postgres, dict)
        or set(postgres) != {"name", "provider", "kind", "version"}
        or postgres.get("kind") != "postgres"
        or set(placement) != {
            "instance", "relative_path", "database_identifier", "cache_prefix", "site_host",
        }
        or not isinstance(placement.get("database_identifier"), str)
        or set(destination) != {
            "name", "provider", "bucket", "region", "endpoint", "addressing", "encryption",
            "auth_mode",
        }
        or not isinstance(destination.get("name"), str)
        or destination.get("auth_mode") not in {"ambient", "stored"}
        or (destination["auth_mode"] == "stored") != (aws_credentials is not None)
    ):
        raise RunnerFailure("policy_stale")
    try:
        store = target_capture.BotoObjectStore(destination, aws_credentials)
        point_id = target_capture.recovery_point_id(
            deployment, destination["name"], scheduled_request
        )
        components = [target_capture.capture_postgres(
            placement["database_identifier"], postgres["version"], directory,
        )]
        if authority["components"] == ["postgres", "valkey"]:
            execution = authority["valkey_execution"]
            valkey = resources.get("valkey")
            if (
                not isinstance(execution, dict)
                or set(execution) != {"prefix", "host", "port", "tls", "auth_mode"}
                or execution.get("auth_mode") not in {"none", "stored"}
                or (execution["auth_mode"] == "stored") != (
                    valkey_credential_path is not None
                )
                or not isinstance(valkey, dict)
                or set(valkey) != {"name", "provider", "kind", "version"}
                or valkey.get("kind") != "valkey"
            ):
                raise RunnerFailure("policy_stale")
            components.append(target_capture.capture_valkey(
                execution["prefix"], execution["host"], execution["port"],
                execution["tls"], valkey["version"], directory,
                valkey_credential_path,
            ))
        return target_capture.publish(
            store, deployment, destination["name"], point_id, components,
            observed_at=observed_at,
        )
    except RunnerFailure:
        raise
    except Exception as error:
        safe = str(error)
        allowed = {
            "credentials_unavailable", "destination_unavailable", "recovery_capture_failed",
            "recovery_dump_metadata_invalid", "recovery_capacity_insufficient",
            "recovery_component_verification_failed", "recovery_manifest_tampered",
            "recovery_manifest_invalid", "backup_destination_upload_access_denied",
            "backup_destination_upload_unavailable", "backup_destination_head_unavailable",
            "backup_destination_read_unavailable",
        }
        raise RunnerFailure(safe if safe in allowed else "capture_failed") from None
    finally:
        for component in locals().get("components", []):
            try:
                component.path.unlink(missing_ok=True)
            except OSError:
                pass


def main() -> int:
    # Installation/activation follows only with the shared capture executable.
    if len(sys.argv) != 3 or sys.argv[1] not in {"scheduled", "status"}:
        return 2
    if NAME.fullmatch(sys.argv[2]) is None:
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
