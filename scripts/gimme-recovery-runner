#!/usr/bin/python3
"""Fixed unattended Recovery Schedule orchestration core.

This source is deliberately not installed until the common capture executable is complete.
"""

from __future__ import annotations

import fcntl
import base64
import hashlib
import importlib.util
import json
import os
import re
import subprocess  # nosec B404 -- fixed sudo/helper argv only
import sys
import tempfile
import time
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any, Callable


EXPECTED_APPS_ROOT = Path("__GIMME_APPS_ROOT__")
STATUS_ROOT = Path("/var/lib/gimme/recovery-schedules")
TARGET_CAPTURE = Path("/usr/local/libexec/gimme_target_capture.py")
VALKEY_CAPTURE = Path("/usr/local/libexec/gimme-capture-valkey")
EXPECTED_TARGET_CAPTURE_SHA256 = "__GIMME_TARGET_CAPTURE_SHA256__"
EXPECTED_VALKEY_CAPTURE_SHA256 = "__GIMME_VALKEY_CAPTURE_SHA256__"
ROOT_UID = 0
SUDO = "/usr/bin/sudo"
MAINTENANCE_HELPER = "/usr/local/sbin/gimme-recovery-maintenance"
NAME = re.compile(r"^[a-z][a-z0-9-]{0,63}$")
REQUEST = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
FINGERPRINT = re.compile(r"^[a-f0-9]{64}$")
STATUS_KEYS = {
    "schema_version", "deployment", "last_logical_slot", "started_at", "finished_at",
    "outcome", "error_code", "recovery_point_id", "last_verified_recovery_point_id",
    "retention_outcome", "retention_deleted", "retention_remaining",
}
OUTCOMES = {
    "succeeded", "backup_succeeded_retention_failed", "deployment_busy", "policy_stale",
    "credentials_unavailable", "credentials_expired", "destination_unavailable",
    "capture_failed", "verification_failed", "retention_failed", "status_unavailable",
}
ERROR_CODES = OUTCOMES | {
    "maintenance_failed", "maintenance_route_validation_failed",
    "maintenance_route_reload_failed", "maintenance_quiesce_wait_failed",
    "maintenance_process_control_failed", "postgres_capture_failed",
    "valkey_capture_failed",
    "publish_failed", "provider_runtime_access_denied", "provider_runtime_unavailable",
    "provider_configuration_invalid", "provider_client_unavailable",
}
AUTHORITY_KEYS = {
    "schema_version", "deployment", "target", "policy_fingerprint", "cadence",
    "calendar", "stable_delay_seconds", "retain_last", "quiesce_wait_seconds",
    "components", "placement", "resources", "destination", "status_identity",
    "valkey_execution",
}


class RunnerFailure(RuntimeError):
    pass


def utc(value: datetime) -> datetime:
    if value.tzinfo is None:
        raise RunnerFailure("status_unavailable")
    return value.astimezone(UTC)


def latest_slot(cadence: dict[str, Any], observed_at: datetime) -> datetime | None:
    observed = utc(observed_at)
    kind = cadence.get("kind")
    if kind == "manual" and set(cadence) == {"kind"}:
        return None
    if kind == "hourly" and set(cadence) == {"kind", "minute"}:
        minute = cadence["minute"]
        if isinstance(minute, bool) or not isinstance(minute, int) or not 0 <= minute <= 59:
            raise RunnerFailure("policy_stale")
        candidate = observed.replace(minute=minute, second=0, microsecond=0)
        return candidate if candidate <= observed else candidate - timedelta(hours=1)
    expected = {"kind", "hour", "minute"}
    if kind == "weekly":
        expected.add("weekday")
    if set(cadence) != expected or kind not in {"daily", "weekly"}:
        raise RunnerFailure("policy_stale")
    hour, minute = cadence["hour"], cadence["minute"]
    if any(isinstance(v, bool) or not isinstance(v, int) for v in (hour, minute)):
        raise RunnerFailure("policy_stale")
    if not 0 <= hour <= 23 or not 0 <= minute <= 59:
        raise RunnerFailure("policy_stale")
    candidate = observed.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if kind == "weekly":
        weekdays = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")
        if cadence["weekday"] not in weekdays:
            raise RunnerFailure("policy_stale")
        candidate -= timedelta(days=(candidate.weekday() - weekdays.index(cadence["weekday"])) % 7)
        return candidate if candidate <= observed else candidate - timedelta(days=7)
    return candidate if candidate <= observed else candidate - timedelta(days=1)


def request_id(deployment: str, policy_fingerprint: str, logical_slot: datetime) -> str:
    if NAME.fullmatch(deployment) is None or FINGERPRINT.fullmatch(policy_fingerprint) is None:
        raise RunnerFailure("policy_stale")
    encoded = (
        f"gimme-scheduled-recovery-v1\0{deployment}\0{policy_fingerprint}\0"
        f"{utc(logical_slot).isoformat()}"
    ).encode()
    digest = hashlib.sha256(encoded).hexdigest()[:20]
    return f"scheduled-{digest}"


def validate_status(document: dict[str, Any]) -> dict[str, Any]:
    if (
        set(document) != STATUS_KEYS
        or document.get("schema_version") != 1
        or document["outcome"] not in OUTCOMES | {None}
        or document["error_code"] not in ERROR_CODES | {None}
        or NAME.fullmatch(str(document["deployment"])) is None
        or any(
            value is not None and (
                not isinstance(value, str) or len(value) > 64
                or datetime.fromisoformat(value).tzinfo is None
            )
            for value in (
                document["last_logical_slot"], document["started_at"],
                document["finished_at"],
            )
        )
        or any(
            value is not None and (
                not isinstance(value, str) or re.fullmatch(r"rp_[a-f0-9]{20}", value) is None
            )
            for value in (
                document["recovery_point_id"],
                document["last_verified_recovery_point_id"],
            )
        )
        or document["retention_outcome"] not in {
            None, "succeeded", "backup_succeeded_retention_failed",
        }
        or any(
            isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 10_000
            for value in (
                document["retention_deleted"], document["retention_remaining"],
            )
        )
    ):
        raise RunnerFailure("status_unavailable")
    return document


def atomic_status(path: Path, document: dict[str, Any]) -> None:
    validate_status(document)
    encoded = json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n"
    if len(encoded.encode()) > 16 * 1024:
        raise RunnerFailure("status_unavailable")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w") as handle:
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise


def acquire_lock(
    path: Path, timeout_seconds: int = 300, *, monotonic: Callable[[], float] = time.monotonic,
    pause: Callable[[float], None] = time.sleep,
):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    handle = path.open("a+")
    os.chmod(path, 0o600)
    deadline = monotonic() + timeout_seconds
    while True:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if monotonic() >= deadline:
                handle.close()
                return None
            pause(min(1.0, max(0.0, deadline - monotonic())))


def attempt_status(
    deployment: str, logical_slot: datetime, started_at: datetime, outcome: str | None,
    *, finished_at: datetime | None = None, error_code: str | None = None,
) -> dict[str, Any]:
    if (
        outcome not in OUTCOMES | {None}
        or error_code not in ERROR_CODES | {None}
        or NAME.fullmatch(deployment) is None
    ):
        raise RunnerFailure("status_unavailable")
    return {
        "schema_version": 1,
        "deployment": deployment,
        "last_logical_slot": utc(logical_slot).isoformat(),
        "started_at": utc(started_at).isoformat(),
        "finished_at": None if finished_at is None else utc(finished_at).isoformat(),
        "outcome": outcome,
        "error_code": error_code,
        "recovery_point_id": None,
        "last_verified_recovery_point_id": None,
        "retention_outcome": None,
        "retention_deleted": 0,
        "retention_remaining": 0,
    }


def startup_failure_status(
    deployment: str, authority: dict[str, Any] | None, outcome: str,
    observed_at: datetime | None = None,
) -> dict[str, Any]:
    """Persist a bounded result when activation fails before execute_scheduled starts."""
    now = utc(observed_at or datetime.now(UTC))
    slot = None
    if isinstance(authority, dict) and isinstance(authority.get("cadence"), dict):
        try:
            slot = latest_slot(authority["cadence"], now)
        except RunnerFailure:
            pass
    status = attempt_status(deployment, slot or now, now, outcome, finished_at=now,
                            error_code=outcome)
    if slot is None:
        status["last_logical_slot"] = None
    return status


def record_startup_failure(
    state: Path, deployment: str, authority: dict[str, Any] | None, outcome: str,
) -> bool:
    """Best-effort status must never replace the original fixed activation failure."""
    try:
        atomic_status(
            state / "status.json",
            startup_failure_status(deployment, authority, outcome),
        )
    except Exception:
        return False
    return True


def load_credential(
    path: Path | None, keys: set[str] | tuple[set[str], ...], *, systemd: bool = False,
) -> dict[str, str] | None:
    if path is None:
        return None
    try:
        details = path.stat()
        if (
            (not systemd and (path.is_symlink() or details.st_mode & 0o077))
            or not path.is_file()
            or details.st_size > 16 * 1024
        ):
            raise RunnerFailure("credentials_unavailable")
        value = json.loads(path.read_text())
    except RunnerFailure:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError):
        raise RunnerFailure("credentials_unavailable") from None
    allowed = (keys,) if isinstance(keys, set) else keys
    if (
        not isinstance(value, dict)
        or set(value) not in allowed
        or not all(
            isinstance(item, str) and item and "\0" not in item and "\n" not in item
            for item in value.values()
        )
    ):
        raise RunnerFailure("credentials_unavailable")
    return value


def load_document(path: Path, max_bytes: int, *, systemd: bool = False) -> dict[str, Any]:
    try:
        details = path.stat()
        if (
            (not systemd and (path.is_symlink() or details.st_mode & 0o077))
            or not path.is_file()
            or not 1 <= details.st_size <= max_bytes
        ):
            raise RunnerFailure("policy_stale")
        value = json.loads(path.read_text())
    except RunnerFailure:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError):
        raise RunnerFailure("policy_stale") from None
    if not isinstance(value, dict):
        raise RunnerFailure("policy_stale")
    return value


def load_target_capture():
    for path, expected, executable in (
        (TARGET_CAPTURE, EXPECTED_TARGET_CAPTURE_SHA256, False),
        (VALKEY_CAPTURE, EXPECTED_VALKEY_CAPTURE_SHA256, True),
    ):
        try:
            details = path.stat()
            valid = (
                not path.is_symlink() and path.is_file() and details.st_uid == ROOT_UID
                and not details.st_mode & 0o022
                and (not executable or os.access(path, os.X_OK))
                and hashlib.sha256(path.read_bytes()).hexdigest() == expected
            )
        except OSError:
            valid = False
        if not valid:
            raise RunnerFailure("policy_stale")
    spec = importlib.util.spec_from_file_location("gimme_target_capture", TARGET_CAPTURE)
    if spec is None or spec.loader is None:
        raise RunnerFailure("policy_stale")
    module = importlib.util.module_from_spec(spec)
    try:
        sys.modules[spec.name] = module
        spec.loader.exec_module(module)
    except Exception:
        sys.modules.pop(spec.name, None)
        raise RunnerFailure("policy_stale") from None
    return module


def maintenance(
    action: str, authority: dict[str, Any], request: str, *, execute=subprocess.run,
) -> None:
    placement = authority.get("placement")
    wait = authority.get("quiesce_wait_seconds")
    instance = placement.get("instance") if isinstance(placement, dict) else None
    if (
        action not in {"enter", "exit"} or not isinstance(instance, str)
        or NAME.fullmatch(instance) is None or REQUEST.fullmatch(request) is None
        or isinstance(wait, bool) or not isinstance(wait, int) or not 1 <= wait <= 300
    ):
        raise RunnerFailure("policy_stale")
    request_root = EXPECTED_APPS_ROOT / ".gimme" / "recovery-requests"
    request_path = request_root / f"{instance}.json"
    if action == "enter":
        request_root.mkdir(parents=True, exist_ok=True, mode=0o700)
        descriptor, temporary = tempfile.mkstemp(prefix=f".{instance}.", dir=request_root)
        temporary_path = Path(temporary)
        try:
            with os.fdopen(descriptor, "w") as handle:
                json.dump({
                    "schema_version": 1, "deployment": instance, "request_id": request,
                    "quiesce_wait_seconds": wait,
                }, handle, sort_keys=True, separators=(",", ":"))
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary_path, 0o600)
            os.replace(temporary_path, request_path)
        except BaseException:
            temporary_path.unlink(missing_ok=True)
            raise
    succeeded = False
    try:
        result = execute(
            [SUDO, "-n", MAINTENANCE_HELPER, action, instance, request],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE, timeout=900, check=False, text=True,
        )
        if result.returncode != 0:
            marker = "GIMME_RECOVERY_MAINTENANCE_FAILED|"
            reported = result.stderr.strip() if isinstance(result.stderr, str) else ""
            code = reported.removeprefix(marker) if reported.startswith(marker) else ""
            if code not in ERROR_CODES or not code.startswith("maintenance_"):
                code = "maintenance_failed"
            raise RunnerFailure(code)
        succeeded = True
    except RunnerFailure:
        raise
    except Exception:
        raise RunnerFailure("maintenance_failed") from None
    finally:
        if action == "exit" and succeeded:
            request_path.unlink(missing_ok=True)


def mapped_capture_failure(error: Exception, default: str) -> RunnerFailure:
    safe = str(error)
    mapped = {
        "credentials_unavailable": "credentials_unavailable",
        "credentials_expired": "credentials_expired",
        "destination_unavailable": "destination_unavailable",
        "recovery_component_verification_failed": "verification_failed",
        "recovery_manifest_tampered": "verification_failed",
        "recovery_manifest_invalid": "verification_failed",
        "provider_runtime_access_denied": "provider_runtime_access_denied",
        "provider_runtime_unavailable": "provider_runtime_unavailable",
        "provider_configuration_invalid": "provider_configuration_invalid",
        "provider_client_unavailable": "provider_client_unavailable",
    }
    return RunnerFailure(mapped.get(safe, default))


def capture_recovery(
    authority: dict[str, Any], scheduled_request: str, directory: Path,
    target_capture: Any, *, aws_credentials: dict[str, str] | None = None,
    valkey_credential_path: Path | None = None, observed_at: datetime | None = None,
    object_store: Any | None = None,
    before_publish: Callable[[], None] | None = None,
) -> dict[str, object]:
    """Execute only the capture policy already validated and fingerprinted by reconciliation."""
    if (
        set(authority) != AUTHORITY_KEYS
        or authority.get("schema_version") != 2
        or not isinstance(authority.get("deployment"), str)
        or NAME.fullmatch(authority["deployment"]) is None
        or authority.get("status_identity") != authority["deployment"]
        or authority.get("components") not in (["postgres"], ["postgres", "valkey"])
        or not isinstance(authority.get("placement"), dict)
        or not isinstance(authority.get("resources"), dict)
        or not isinstance(authority.get("destination"), dict)
    ):
        raise RunnerFailure("policy_stale")
    deployment = authority["deployment"]
    resources = authority["resources"]
    placement = authority["placement"]
    destination = authority["destination"]
    postgres = resources.get("postgres")
    if (
        set(resources) != set(authority["components"])
        or not isinstance(postgres, dict)
        or set(postgres) != {"name", "provider", "kind", "version"}
        or postgres.get("kind") != "postgres"
        or set(placement) != {
            "instance", "relative_path", "database_identifier", "cache_prefix", "site_host",
        }
        or not isinstance(placement.get("database_identifier"), str)
        or set(destination) != {
            "name", "provider", "bucket", "region", "endpoint", "addressing", "encryption",
            "auth_mode",
        }
        or not isinstance(destination.get("name"), str)
        or destination.get("auth_mode") not in {"ambient", "stored"}
        or (destination["auth_mode"] == "stored") != (aws_credentials is not None)
    ):
        raise RunnerFailure("policy_stale")
    stage = "capture"
    try:
        store = object_store or target_capture.BotoObjectStore(destination, aws_credentials)
        point_id = target_capture.recovery_point_id(
            deployment, destination["name"], scheduled_request
        )
        stage = "postgres_capture"
        components = [target_capture.capture_postgres(
            placement["database_identifier"], postgres["version"], directory,
        )]
        if authority["components"] == ["postgres", "valkey"]:
            execution = authority["valkey_execution"]
            valkey = resources.get("valkey")
            if (
                not isinstance(execution, dict)
                or set(execution) != {"prefix", "host", "port", "tls", "auth_mode"}
                or execution.get("auth_mode") not in {"none", "stored"}
                or (execution["auth_mode"] == "stored") != (
                    valkey_credential_path is not None
                )
                or not isinstance(valkey, dict)
                or set(valkey) != {"name", "provider", "kind", "version"}
                or valkey.get("kind") != "valkey"
            ):
                raise RunnerFailure("policy_stale")
            stage = "valkey_capture"
            components.append(target_capture.capture_valkey(
                execution["prefix"], execution["host"], execution["port"],
                execution["tls"], valkey["version"], directory,
                valkey_credential_path,
            ))
        stage = "publish"
        return target_capture.publish(
            store, deployment, destination["name"], point_id, components,
            observed_at=observed_at, before_publish=before_publish,
        )
    except RunnerFailure:
        raise
    except Exception as error:
        raise mapped_capture_failure(error, f"{stage}_failed") from None
    finally:
        for component in locals().get("components", []):
            try:
                component.path.unlink(missing_ok=True)
            except OSError:
                pass


def validate_policy(authority: dict[str, Any]) -> tuple[str, dict[str, Any], int, str]:
    deployment = str(authority.get("deployment"))
    cadence = authority.get("cadence")
    delay = authority.get("stable_delay_seconds")
    fingerprint = authority.get("policy_fingerprint")
    destination = authority.get("destination")
    if (
        NAME.fullmatch(deployment) is None or not isinstance(cadence, dict)
        or isinstance(delay, bool) or not isinstance(delay, int) or not 0 <= delay <= 300
        or not isinstance(fingerprint, str) or not isinstance(destination, dict)
    ):
        raise RunnerFailure("policy_stale")
    expected_policy = {
        "destination": destination.get("name"),
        "valkey": authority.get("components") == ["postgres", "valkey"],
        "quiesce_wait_seconds": authority.get("quiesce_wait_seconds"),
        "cadence": cadence, "retain_last": authority.get("retain_last"),
    }
    expected_fingerprint = hashlib.sha256(json.dumps(
        expected_policy, sort_keys=True, separators=(",", ":")
    ).encode()).hexdigest()
    expected_delay = int.from_bytes(
        hashlib.sha256(f"gimme-recovery-jitter-v1\0{deployment}".encode()).digest()[:8],
        "big",
    ) % 301
    if fingerprint != expected_fingerprint or delay != expected_delay:
        raise RunnerFailure("policy_stale")
    return deployment, cadence, delay, fingerprint


def execute_capture_policy(
    authority: dict[str, Any], capture_request: str, target_capture: Any, directory: Path,
    *, aws_credentials: dict[str, str] | None = None,
    valkey_credential_path: Path | None = None, observed_at: datetime | None = None,
) -> dict[str, Any]:
    deployment, _cadence, _delay, _fingerprint = validate_policy(authority)
    if REQUEST.fullmatch(capture_request) is None:
        raise RunnerFailure("policy_stale")
    destination = authority["destination"]
    try:
        store = target_capture.BotoObjectStore(destination, aws_credentials)
        point_id = target_capture.recovery_point_id(
            deployment, str(destination["name"]), capture_request
        )
        manifest = target_capture.find_recovery_point(
            store, deployment, str(destination["name"]), point_id
        )
    except Exception as error:
        raise mapped_capture_failure(error, "capture_failed") from None
    changed = manifest is None
    if manifest is None:
        maintenance_active = False

        def restore_runtime() -> None:
            nonlocal maintenance_active
            if maintenance_active:
                maintenance("exit", authority, capture_request)
                maintenance_active = False

        try:
            if authority.get("components") == ["postgres", "valkey"]:
                maintenance_active = True
                maintenance("enter", authority, capture_request)
            manifest = capture_recovery(
                authority, capture_request, directory, target_capture,
                aws_credentials=aws_credentials,
                valkey_credential_path=valkey_credential_path,
                observed_at=observed_at, object_store=store,
                before_publish=restore_runtime if maintenance_active else None,
            )
        finally:
            restore_runtime()
    point_id = str(manifest["recovery_point_id"])
    retention = target_capture.enforce_retention(
        store, deployment, str(destination["name"]), authority["retain_last"], point_id,
    )
    return {
        "changed": changed, "recovery_point_id": point_id, "retention": retention,
    }


def execute_scheduled(
    authority: dict[str, Any], target_capture: Any, status_path: Path, lock_path: Path,
    directory: Path, *, aws_credentials: dict[str, str] | None = None,
    valkey_credential_path: Path | None = None, observed_at: datetime | None = None,
    pause: Callable[[float], None] = time.sleep,
) -> dict[str, Any]:
    """Run one latest-slot activation with bounded delay, lock, status, capture, and retention."""
    now = utc(observed_at or datetime.now(UTC))
    deployment, cadence, delay, fingerprint = validate_policy(authority)
    slot = latest_slot(cadence, now)
    if slot is None:
        raise RunnerFailure("policy_stale")
    remaining_delay = (slot + timedelta(seconds=delay) - now).total_seconds()
    if remaining_delay > 0:
        pause(min(300.0, remaining_delay))
    started = datetime.now(UTC) if observed_at is None else now + timedelta(
        seconds=max(0.0, remaining_delay)
    )
    status = attempt_status(deployment, slot, started, None)
    atomic_status(status_path, status)
    handle = acquire_lock(lock_path)
    if handle is None:
        status.update({
            "finished_at": datetime.now(UTC).isoformat(), "outcome": "deployment_busy",
            "error_code": "deployment_busy",
        })
        atomic_status(status_path, status)
        return status
    try:
        scheduled_request = request_id(deployment, fingerprint, slot)
        execution = execute_capture_policy(
            authority, scheduled_request, target_capture, directory,
            aws_credentials=aws_credentials, valkey_credential_path=valkey_credential_path,
            observed_at=started,
        )
        point_id = execution["recovery_point_id"]
        retention = execution["retention"]
        status.update({
            "finished_at": datetime.now(UTC).isoformat(),
            "outcome": retention["outcome"], "error_code": retention["error_code"],
            "recovery_point_id": point_id,
            "last_verified_recovery_point_id": point_id,
            "retention_outcome": retention["outcome"],
            "retention_deleted": retention["deleted"],
            "retention_remaining": retention["remaining"],
        })
    except RunnerFailure as error:
        code = str(error)
        outcome = code if code in {
            "credentials_unavailable", "credentials_expired", "destination_unavailable",
            "policy_stale", "verification_failed",
        } else "capture_failed"
        if code.startswith("provider_"):
            outcome = "destination_unavailable"
        error_code = code if code in ERROR_CODES else outcome
        status.update({
            "finished_at": datetime.now(UTC).isoformat(), "outcome": outcome,
            "error_code": error_code,
        })
    except Exception:
        status.update({
            "finished_at": datetime.now(UTC).isoformat(), "outcome": "capture_failed",
            "error_code": "capture_failed",
        })
    finally:
        handle.close()
    atomic_status(status_path, status)
    return status


def execute_on_demand(
    authority: dict[str, Any], capture_request: str, target_capture: Any,
    lock_path: Path, directory: Path, *, aws_credentials: dict[str, str] | None = None,
    valkey_credential_path: Path | None = None,
) -> dict[str, Any]:
    """Execute one caller-reviewed request through the same lock/capture/retention path."""
    handle = acquire_lock(lock_path)
    if handle is None:
        raise RunnerFailure("deployment_busy")
    try:
        return execute_capture_policy(
            authority, capture_request, target_capture, directory,
            aws_credentials=aws_credentials,
            valkey_credential_path=valkey_credential_path,
        )
    finally:
        handle.close()


def main() -> int:
    operation = sys.argv[1] if len(sys.argv) >= 2 else ""
    if (
        (operation in {"scheduled", "status"} and len(sys.argv) != 3)
        or (operation == "on-demand" and len(sys.argv) != 4)
        or operation not in {"scheduled", "status", "on-demand"}
    ):
        return 2
    deployment = sys.argv[2]
    if NAME.fullmatch(deployment) is None:
        return 2
    if sys.argv[1] == "status":
        try:
            status = validate_status(load_document(
                STATUS_ROOT / deployment / "status.json", 16 * 1024
            ))
            encoded = base64.b64encode(json.dumps(
                status, sort_keys=True, separators=(",", ":")
            ).encode()).decode()
            print(f"GIMME_RECOVERY_STATUS|{encoded}")
            return 0
        except Exception:
            return 1
    credentials_value = os.environ.get("CREDENTIALS_DIRECTORY")
    state_value = os.environ.get("STATE_DIRECTORY")
    if not credentials_value or not state_value:
        return 1
    credentials = Path(credentials_value)
    state = Path(state_value)
    systemd_credentials = credentials == (
        Path("/run/credentials") / f"gimme-recovery-{deployment}.service"
    )
    authority = None
    try:
        authority = load_document(
            credentials / "authority", 64 * 1024, systemd=systemd_credentials,
        )
        if authority.get("deployment") != deployment:
            raise RunnerFailure("policy_stale")
        destination = authority.get("destination")
        valkey = authority.get("valkey_execution")
        if not isinstance(destination, dict):
            raise RunnerFailure("policy_stale")
        aws_credentials = load_credential(
            credentials / "aws" if destination.get("auth_mode") == "stored" else None,
            (
                {"access_key_id", "secret_access_key"},
                {"access_key_id", "secret_access_key", "session_token"},
            ),
            systemd=systemd_credentials,
        )
        valkey_path = (
            credentials / "valkey"
            if isinstance(valkey, dict) and valkey.get("auth_mode") == "stored"
            else None
        )
        if valkey_path is not None:
            load_credential(
                valkey_path, {"username", "password"}, systemd=systemd_credentials,
            )
        target_capture = load_target_capture()
        placement = authority.get("placement")
        relative = placement.get("relative_path") if isinstance(placement, dict) else None
        if (
            not isinstance(relative, str) or not relative or len(relative) > 255
            or Path(relative).is_absolute() or ".." in Path(relative).parts
        ):
            raise RunnerFailure("policy_stale")
        # Resource reconciliation already holds this exact Target-side lock while it
        # rewrites Deployment runtime state. Sharing it excludes scheduled/on-demand
        # capture from those mutations even when different controllers are involved.
        lock_path = EXPECTED_APPS_ROOT / relative / "shared" / ".gimme-resource.lock"
        if operation == "on-demand":
            capture_request = sys.argv[3]
            result = execute_on_demand(
                authority, capture_request, target_capture, lock_path, state / "capture",
                aws_credentials=aws_credentials, valkey_credential_path=valkey_path,
            )
            encoded = base64.b64encode(json.dumps(
                result, sort_keys=True, separators=(",", ":")
            ).encode()).decode()
            print(f"GIMME_RECOVERY_RESULT|{encoded}")
            return 0
        result = execute_scheduled(
            authority, target_capture, state / "status.json", lock_path, state / "capture",
            aws_credentials=aws_credentials, valkey_credential_path=valkey_path,
        )
        return 0 if result["outcome"] in {
            "succeeded", "backup_succeeded_retention_failed", "deployment_busy",
        } else 1
    except RunnerFailure as error:
        if operation == "scheduled":
            outcome = str(error)
            if outcome not in {
                "policy_stale", "credentials_unavailable", "credentials_expired",
                "destination_unavailable", "capture_failed", "verification_failed",
            }:
                outcome = "policy_stale"
            record_startup_failure(state, deployment, authority, outcome)
        return 1
    except Exception:
        if operation == "scheduled":
            record_startup_failure(
                state, deployment, authority, "capture_failed",
            )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
