#!/usr/bin/python3
# GIMME_POLICY_ID=__GIMME_POLICY_ID__
"""Reconcile one derived, loopback-only rollout backend as root."""

from __future__ import annotations

import base64
import hashlib
import grp
import json
import os
import pwd
import re
import secrets
import shutil
import stat
import subprocess  # nosec B404 -- fixed executable vectors only
import sys
import tempfile
import time
from pathlib import Path
from typing import Any


APPS_ROOT = Path("__GIMME_APPS_ROOT__")
STATE_ROOT = APPS_ROOT / ".gimme" / "rollouts"
INSTANCE = re.compile(r"^[a-z][a-z0-9-]{0,93}$")
USER = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_-]{0,31}$")
PHP_VERSION = re.compile(r"^[0-9]+\.[0-9]+$")
MAX_STATE_BYTES = 16 * 1024
ROOT_STATE = Path("/var/lib/gimme/rollouts")
FINGERPRINT = re.compile(r"^rollout_[0-9a-f]{64}$")
SITE_HOST = re.compile(
    r"^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+"
    r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])$"
)
HEALTH_PATH = re.compile(r"^/[A-Za-z0-9._~!$&'()*+,;=:@%/?-]{0,255}$")


def fail(message: str) -> None:
    raise RuntimeError(message)


def run(argv: list[str]) -> subprocess.CompletedProcess[str]:
    allowed = {
        "/usr/bin/systemctl",
        "/usr/bin/caddy",
        "/usr/bin/curl",
        "/usr/bin/cp",
        "/usr/local/sbin/gimme-provision-processes",
    }
    if not argv or argv[0] not in allowed:
        fail("rollout helper attempted an unexpected executable")
    return subprocess.run(  # nosec B603
        argv, check=True, text=True, capture_output=True
    )


def atomic_write(path: Path, content: str, mode: int = 0o644) -> bool:
    if path.is_file() and not path.is_symlink() and path.read_text() == content:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise
    return True


def ensure_log(path: Path, uid: int, gid: int) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW,
        0o640,
    )
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            fail("rollout log must be a regular file")
        os.fchmod(descriptor, 0o640)
        os.fchown(descriptor, uid, gid)
    finally:
        os.close(descriptor)


def load(instance: str, version: int = 1) -> dict[str, Any]:
    sudo_user = os.environ.get("SUDO_USER", "")
    if INSTANCE.fullmatch(instance) is None or USER.fullmatch(sudo_user) is None:
        fail("invalid rollout identity")
    state_path = STATE_ROOT / f"{instance}.json"
    if STATE_ROOT.is_symlink() or state_path.is_symlink():
        fail("rollout desired state must not be symlinked")
    details = state_path.stat()
    account = pwd.getpwnam(sudo_user)
    if (
        not stat.S_ISREG(details.st_mode)
        or details.st_uid != account.pw_uid
        or details.st_mode & (stat.S_IRWXG | stat.S_IRWXO)
        or details.st_size > MAX_STATE_BYTES
    ):
        fail("unsafe rollout desired state")
    value = json.loads(state_path.read_text())
    expected = (
        {
            "version", "instance", "generation", "framework", "remote_user",
            "apps_root", "deploy_path", "php_version",
        }
        if version == 1 else {
            "version", "instance", "generation", "affinity_generation",
            "stable_weight", "candidate_weight", "route_fingerprint", "framework",
            "site_host", "network_mode", "deploy_path", "php_version", "health",
            "stable_identity", "candidate_identity",
        } | ({"action", "candidate_build_id"} if version == 3 else set())
    )
    if not isinstance(value, dict) or set(value) != expected:
        fail("invalid rollout desired state document")
    if (
        value["version"] != version
        or value["instance"] != instance
        or (version == 1 and value["remote_user"] != sudo_user)
        or (version == 1 and value["apps_root"] != str(APPS_ROOT))
        or value["framework"] not in {"laravel", "static"}
        or isinstance(value["generation"], bool)
        or not isinstance(value["generation"], int)
        or not 1 <= value["generation"] <= 2_147_483_647
        or not isinstance(value["php_version"], str)
        or PHP_VERSION.fullmatch(value["php_version"]) is None
    ):
        fail("rollout desired state authority mismatch")
    deploy_path = Path(value["deploy_path"])
    root = APPS_ROOT.resolve()
    resolved = deploy_path.resolve(strict=False)
    if not deploy_path.is_absolute() or ".." in deploy_path.parts or (
        resolved == root or not resolved.is_relative_to(root)
    ):
        fail("rollout deploy path escapes applications root")
    candidate = deploy_path / "rollouts" / str(value["generation"]) / "candidate"
    candidate_required = version != 3 or value.get("action") == "complete"
    if candidate_required and (not candidate.is_dir() or candidate.is_symlink()):
        fail("rollout candidate tree is unavailable")
    return {**value, "candidate": candidate, "account": account}


def require_int(value: Any, name: str, minimum: int, maximum: int) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
        fail(f"invalid {name}")
    return value


def validate_weight_policy(
    value: dict[str, Any], *, affinity_matches_generation: bool = True
) -> dict[str, Any]:
    stable = require_int(value["stable_weight"], "stable_weight", 0, 100)
    candidate = require_int(value["candidate_weight"], "candidate_weight", 0, 100)
    if stable + candidate != 100:
        fail("rollout weights must total 100")
    generation = require_int(value["generation"], "generation", 1, 2_147_483_647)
    affinity = require_int(
        value["affinity_generation"], "affinity_generation", 1, 2_147_483_647
    )
    if affinity_matches_generation and affinity != generation:
        fail("affinity generation must match rollout generation")
    if value["framework"] not in {"laravel", "static"}:
        fail("invalid rollout framework")
    if value["network_mode"] not in {"local_mdns", "public_dns"}:
        fail("invalid rollout network mode")
    for field in ("route_fingerprint", "stable_identity", "candidate_identity"):
        if not isinstance(value[field], str) or FINGERPRINT.fullmatch(value[field]) is None:
            fail(f"invalid {field}")
    if value["stable_identity"] == value["candidate_identity"]:
        fail("rollout backend identities must differ")
    if not isinstance(value["site_host"], str) or SITE_HOST.fullmatch(value["site_host"]) is None:
        fail("invalid rollout site host")
    health = value["health"]
    if not isinstance(health, list) or not 1 <= len(health) <= 8:
        fail("invalid rollout health policy")
    validated_health = []
    for probe in health:
        if not isinstance(probe, dict) or set(probe) != {
            "path", "expected_status", "timeout_seconds", "attempts", "delay_seconds"
        }:
            fail("invalid rollout health probe")
        path = probe["path"]
        if not isinstance(path, str) or HEALTH_PATH.fullmatch(path) is None:
            fail("invalid rollout health path")
        validated_health.append({
            "path": path,
            "expected_status": require_int(
                probe["expected_status"], "expected_status", 100, 599
            ),
            "timeout_seconds": require_int(
                probe["timeout_seconds"], "timeout_seconds", 1, 60
            ),
            "attempts": require_int(probe["attempts"], "attempts", 1, 10),
            "delay_seconds": require_int(
                probe["delay_seconds"], "delay_seconds", 0, 60
            ),
        })
    value["health"] = validated_health
    return value


def validate_finalize_policy(value: dict[str, Any]) -> dict[str, Any]:
    validate_weight_policy(value, affinity_matches_generation=False)
    if value["action"] not in {"complete", "reverse"}:
        fail("invalid rollout finalization action")
    if value["affinity_generation"] == value["generation"]:
        fail("rollout finalization must rotate affinity")
    if (
        not isinstance(value["candidate_build_id"], str)
        or re.fullmatch(r"build_v1_[0-9a-f]{64}", value["candidate_build_id"]) is None
    ):
        fail("invalid rollout candidate build")
    if value["action"] == "complete" and value["candidate_weight"] != 100:
        fail("completion requires candidate weight 100")
    return value


def backend_port(identity: str) -> int:
    digest = hashlib.sha256(identity.encode()).digest()
    return 20_000 + int.from_bytes(digest[:2], "big") % 20_000


def emit_state(value: dict[str, Any]) -> None:
    encoded = base64.b64encode(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    ).decode()
    print(f"GIMME_ROLLOUT_STATE|{encoded}")


def main_prepare(instance: str) -> None:
    value = load(instance)
    instance = value["instance"]
    generation = value["generation"]
    identity = f"{instance}-{generation}"
    port = backend_port(identity)
    candidate: Path = value["candidate"]
    logs = candidate.parent / "logs"
    runtime = candidate.parent / "runtime"
    logs.mkdir(mode=0o750, exist_ok=True)
    runtime.mkdir(mode=0o750, exist_ok=True)
    account = value["account"]
    group = grp.getgrgid(account.pw_gid).gr_name
    caddy = pwd.getpwnam("caddy")
    os.chmod(logs, 0o750)  # nosec B103 -- caddy needs group traverse to its log
    os.chown(logs, account.pw_uid, caddy.pw_gid)
    os.chown(runtime, account.pw_uid, account.pw_gid)
    ensure_log(logs / "access.log", caddy.pw_uid, caddy.pw_gid)
    ensure_log(logs / "php-fpm.log", account.pw_uid, account.pw_gid)

    site = Path("/etc/caddy/gimme-rollouts") / f"{identity}.caddy"
    if value["framework"] == "laravel":
        pool_name = f"gimme-rollout-{identity}"
        socket = Path("/run/php") / f"{pool_name}.sock"
        pool = Path(f"/etc/php/{value['php_version']}/fpm/pool.d") / f"{pool_name}.conf"
        pool_content = (
            f"[{pool_name}]\nuser = {account.pw_name}\ngroup = {group}\n"
            f"listen = {socket}\nlisten.owner = caddy\nlisten.group = caddy\n"
            "listen.mode = 0660\npm = ondemand\npm.max_children = 4\n"
            "pm.process_idle_timeout = 10s\npm.max_requests = 500\n"
            f"chdir = {candidate}\ncatch_workers_output = yes\n"
            f"php_admin_value[error_log] = {logs / 'php-fpm.log'}\n"
        )
        atomic_write(pool, pool_content)
        public = candidate / "public"
        caddy_body = (
            f"http://127.0.0.1:{port} {{\n\troot * {public}\n"
            f"\tphp_fastcgi unix//{socket}\n\tfile_server\n"
            f"\tlog {{ output file {logs / 'access.log'} }}\n}}\n"
        )
        run(["/usr/bin/systemctl", "reload", f"php{value['php_version']}-fpm.service"])
    else:
        caddy_body = (
            f"http://127.0.0.1:{port} {{\n\troot * {candidate}\n\tfile_server\n"
            f"\tlog {{ output file {logs / 'access.log'} }}\n}}\n"
        )
    atomic_write(site, caddy_body)
    run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
    run(["/usr/bin/systemctl", "reload", "caddy.service"])
    print("GIMME_ROLLOUT_BACKEND|ready")


def root_state(instance: str) -> dict[str, Any] | None:
    if INSTANCE.fullmatch(instance) is None:
        fail("invalid rollout identity")
    path = ROOT_STATE / f"{instance}.json"
    if not path.exists():
        return None
    if path.is_symlink() or path.stat().st_size > MAX_STATE_BYTES:
        fail("unsafe root rollout state")
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        fail("invalid root rollout state")
    return value


def signing_key(instance: str, generation: int) -> str:
    ROOT_STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(ROOT_STATE, 0o700)
    path = ROOT_STATE / f"{instance}.key"
    generation_path = ROOT_STATE / f"{instance}.generation"
    current_generation = generation_path.read_text() if generation_path.is_file() else ""
    if path.is_file() and not path.is_symlink() and current_generation == str(generation):
        key = path.read_text()
        if re.fullmatch(r"[0-9a-f]{64}", key):
            return key
    key = secrets.token_hex(32)
    atomic_write(path, key, 0o600)
    atomic_write(generation_path, str(generation), 0o600)
    return key


def internal_sites(value: dict[str, Any]) -> tuple[str, int, int]:
    instance = value["instance"]
    generation = value["generation"]
    candidate_port = backend_port(f"{instance}-{generation}")
    stable_port = backend_port(f"stable-{instance}-{generation}")
    if stable_port == candidate_port:
        fail("rollout backend identity collision")
    deploy_path = Path(value["deploy_path"])
    candidate = deploy_path / "rollouts" / str(generation) / "candidate"
    current = deploy_path / "current"
    try:
        stable = current.resolve(strict=True)
    except OSError:
        fail("stable rollout release is unavailable")
    releases = deploy_path / "releases"
    if not stable.is_relative_to(releases) or not stable.is_dir():
        fail("stable rollout release is invalid")
    if value["framework"] == "laravel":
        stable_root = stable / "public"
        candidate_root = candidate / "public"
        stable_socket = f"/run/php/php{value['php_version']}-fpm.sock"
        candidate_socket = f"/run/php/gimme-rollout-{instance}-{generation}.sock"
        body = (
            f"http://127.0.0.1:{stable_port} {{\n\troot * {stable_root}\n"
            f"\tphp_fastcgi unix//{stable_socket}\n\tfile_server\n}}\n"
            f"http://127.0.0.1:{candidate_port} {{\n\troot * {candidate_root}\n"
            f"\tphp_fastcgi unix//{candidate_socket}\n\tfile_server\n}}\n"
        )
    else:
        body = (
            f"http://127.0.0.1:{stable_port} {{\n\troot * {stable}\n\tfile_server\n}}\n"
            f"http://127.0.0.1:{candidate_port} {{\n\troot * {candidate}\n\tfile_server\n}}\n"
        )
    return body, stable_port, candidate_port


def public_site(
    value: dict[str, Any], stable_port: int, candidate_port: int, key: str
) -> str:
    upstreams, weights = [], []
    if value["stable_weight"] > 0:
        upstreams.append(f"127.0.0.1:{stable_port}")
        weights.append(str(value["stable_weight"]))
    if value["candidate_weight"] > 0:
        upstreams.append(f"127.0.0.1:{candidate_port}")
        weights.append(str(value["candidate_weight"]))
    cookie = "__Host-gimme-" + hashlib.sha256(value["instance"].encode()).hexdigest()[:16]
    probe = value["health"][0]
    tls = "\ttls internal\n" if value["network_mode"] == "local_mdns" else ""
    return (
        f"{value['site_host']} {{\n{tls}\tencode zstd gzip\n"
        f"\treverse_proxy {' '.join(upstreams)} {{\n"
        f"\t\tlb_policy cookie {cookie} {key} {{\n"
        f"\t\t\tfallback weighted_round_robin {' '.join(weights)}\n\t\t}}\n"
        f"\t\thealth_uri {probe['path']}\n"
        f"\t\thealth_status {probe['expected_status']}\n"
        "\t\thealth_interval 10s\n\t\thealth_timeout 5s\n"
        f"\t\thealth_headers {{\n\t\t\tHost {value['site_host']}\n\t\t}}\n"
        "\t\tfail_duration 30s\n\t\tmax_fails 2\n"
        "\t\tlb_retries 1\n\t\tlb_try_duration 1s\n\t\tlb_try_interval 100ms\n"
        "\t\tlb_retry_match {\n\t\t\tmethod GET HEAD\n\t\t}\n"
        f"\t\theader_down Set-Cookie \"^({cookie}=[0-9a-f]{{64}}; Path=/; Secure; "
        "HttpOnly); SameSite=None$\" \"$1; SameSite=Lax\"\n"
        "\t}\n}\n"
    )


def probe(url: str, host: str, policy: dict[str, Any], *, public: bool = False) -> None:
    for item in policy["health"]:
        target = url + item["path"]
        command = [
            "/usr/bin/curl", "--silent", "--output", "/dev/null", "--write-out",
            "%{http_code}", "--max-time", str(item["timeout_seconds"]),
        ]
        if public and policy["network_mode"] == "local_mdns":
            command.extend([
                "--resolve", f"{host}:443:127.0.0.1", "--cacert",
                str(APPS_ROOT / ".caddy-local-root.crt"),
            ])
        elif not public:
            command.extend(["--header", f"Host: {host}"])
        command.append(target)
        for attempt in range(item["attempts"]):
            try:
                result = run(command)
                if result.stdout == str(item["expected_status"]):
                    break
            except subprocess.CalledProcessError:
                pass
            if attempt + 1 == item["attempts"]:
                fail("rollout health failed")
            time.sleep(item["delay_seconds"])


def safe_target_state(value: dict[str, Any], outcome: str = "ready") -> dict[str, Any]:
    return {
        "configured": True,
        "generation": value["generation"],
        "phase": "active",
        "affinity_generation": value["affinity_generation"],
        "stable_weight": value["stable_weight"],
        "candidate_weight": value["candidate_weight"],
        "stable_eligible": value["stable_weight"] > 0,
        "candidate_eligible": value["candidate_weight"] > 0,
        "stable_health": "ready",
        "candidate_health": "ready",
        "stable_identity": value["stable_identity"],
        "candidate_identity": value["candidate_identity"],
        "route_fingerprint": value["route_fingerprint"],
        "outcome": outcome,
    }


def main_weights(instance: str) -> None:
    value = validate_weight_policy(load(instance, 2))
    internal, stable_port, candidate_port = internal_sites(value)
    internal_path = Path("/etc/caddy/gimme-rollouts") / f"{instance}-{value['generation']}.caddy"
    public_path = Path("/etc/caddy/gimme") / f"{instance}.caddy"
    if not public_path.is_file() or public_path.is_symlink():
        fail("rollout public route is unavailable")
    previous = public_path.read_text()
    previous_stat = public_path.stat()
    atomic_write(internal_path, internal)
    run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
    run(["/usr/bin/systemctl", "reload", "caddy.service"])
    probe(f"http://127.0.0.1:{stable_port}", value["site_host"], value)
    probe(f"http://127.0.0.1:{candidate_port}", value["site_host"], value)
    key = signing_key(instance, value["generation"])
    proposed = public_site(value, stable_port, candidate_port, key)
    try:
        atomic_write(public_path, proposed, 0o640)
        os.chown(public_path, 0, pwd.getpwnam("caddy").pw_gid)
        run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
        run(["/usr/bin/systemctl", "reload", "caddy.service"])
        probe(f"http://127.0.0.1:{stable_port}", value["site_host"], value)
        probe(f"http://127.0.0.1:{candidate_port}", value["site_host"], value)
        probe(f"https://{value['site_host']}", value["site_host"], value, public=True)
    except BaseException:
        try:
            atomic_write(public_path, previous, stat.S_IMODE(previous_stat.st_mode))
            os.chown(public_path, previous_stat.st_uid, previous_stat.st_gid)
            run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
            run(["/usr/bin/systemctl", "reload", "caddy.service"])
            probe(f"http://127.0.0.1:{stable_port}", value["site_host"], value)
            probe(
                f"https://{value['site_host']}", value["site_host"], value, public=True
            )
        except BaseException:
            fail("rollout route rollback failed")
        fail("rollout route transition failed")
    state = safe_target_state(value)
    ROOT_STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(ROOT_STATE, 0o700)
    atomic_write(ROOT_STATE / f"{instance}.json", json.dumps(
        state, sort_keys=True, separators=(",", ":")
    ), 0o600)
    emit_state(state)


def normal_site(value: dict[str, Any]) -> str:
    deploy_path = Path(value["deploy_path"])
    root = deploy_path / "current"
    if value["framework"] == "laravel":
        root = root / "public"
        handler = (
            f"\tphp_fastcgi unix//run/php/php{value['php_version']}-fpm.sock {{\n"
            "\t\tresolve_root_symlink\n\t}\n"
        )
    else:
        handler = ""
    tls = "\ttls internal\n" if value["network_mode"] == "local_mdns" else ""
    return (
        f"{value['site_host']} {{\n{tls}\troot * {root}\n\tencode zstd gzip\n"
        f"{handler}\tfile_server {{\n\t\thide .git* .env* .hg* .svn\n\t}}\n}}\n"
    )


def reconcile_processes(instance: str) -> None:
    state = APPS_ROOT / ".gimme" / "processes" / f"{instance}.json"
    if state.is_file() and not state.is_symlink():
        run(["/usr/local/sbin/gimme-provision-processes", instance, "refresh"])


def replace_current(current: Path, target: str, account: pwd.struct_passwd) -> None:
    temporary = current.parent / f".gimme-current-{secrets.token_hex(8)}"
    try:
        temporary.symlink_to(target)
        os.lchown(temporary, account.pw_uid, account.pw_gid)
        os.replace(temporary, current)
    finally:
        temporary.unlink(missing_ok=True)


def main_finalize(instance: str) -> None:
    value = validate_finalize_policy(load(instance, 3))
    action = value["action"]
    deploy_path = Path(value["deploy_path"])
    current = deploy_path / "current"
    releases = deploy_path / "releases"
    public_path = Path("/etc/caddy/gimme") / f"{instance}.caddy"
    internal_path = (
        Path("/etc/caddy/gimme-rollouts")
        / f"{instance}-{value['generation']}.caddy"
    )
    pool_path = (
        Path(f"/etc/php/{value['php_version']}/fpm/pool.d")
        / f"gimme-rollout-{instance}-{value['generation']}.conf"
    )
    if not current.is_symlink() or not public_path.is_file() or public_path.is_symlink():
        fail("rollout finalization prerequisites are unavailable")
    previous_current = os.readlink(current)
    stable_release = current.resolve(strict=True)
    if not stable_release.is_relative_to(releases):
        fail("rollout stable release is invalid")
    previous_public = public_path.read_text()
    previous_public_stat = public_path.stat()
    previous_internal = internal_path.read_text() if internal_path.is_file() else None
    previous_pool = pool_path.read_text() if pool_path.is_file() else None
    log_path = deploy_path / ".dep" / "releases_log"
    latest_path = deploy_path / ".dep" / "latest_release"
    previous_log = log_path.read_text() if log_path.is_file() else None
    previous_latest = latest_path.read_text() if latest_path.is_file() else None
    key_path = ROOT_STATE / f"{instance}.key"
    key_generation_path = ROOT_STATE / f"{instance}.generation"
    previous_key = key_path.read_text() if key_path.is_file() else None
    previous_key_generation = (
        key_generation_path.read_text() if key_generation_path.is_file() else None
    )
    internal, stable_port, candidate_port = internal_sites(value)
    atomic_write(internal_path, internal)
    run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
    run(["/usr/bin/systemctl", "reload", "caddy.service"])
    selected_port = candidate_port if action == "complete" else stable_port
    probe(f"http://127.0.0.1:{selected_port}", value["site_host"], value)

    release_path: Path | None = None
    retired_path: Path | None = None
    try:
        if action == "complete":
            candidate = value["candidate"]
            metadata_path = candidate / ".gimme-artifact.json"
            metadata = json.loads(metadata_path.read_text())
            if metadata.get("build_id") != value["candidate_build_id"]:
                fail("rollout candidate metadata is stale")
            release_name = str(8_000_000_000 + value["generation"])
            release_path = releases / release_name
            if release_path.exists():
                fail("rollout promoted release already exists")
            run(["/usr/bin/cp", "-a", "--", str(candidate), str(release_path)])
            record = json.dumps({
                "created_at": time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()),
                "release_name": release_name,
                "user": value["account"].pw_name,
                "target": value["site_host"],
            }, sort_keys=True, separators=(",", ":"))
            log_path.parent.mkdir(parents=True, exist_ok=True)
            atomic_write(log_path, (previous_log or "") + record + "\n")
            atomic_write(latest_path, release_name + "\n")
            replace_current(current, f"releases/{release_name}", value["account"])
            reconcile_processes(instance)

        atomic_write(public_path, normal_site(value), 0o644)
        run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
        run(["/usr/bin/systemctl", "reload", "caddy.service"])
        probe(f"https://{value['site_host']}", value["site_host"], value, public=True)

        if action == "reverse":
            reconcile_processes(instance)
        generation_root = deploy_path / "rollouts" / str(value["generation"])
        if generation_root.exists():
            retired_path = generation_root.with_name(
                f".{value['generation']}.retired-{secrets.token_hex(8)}"
            )
            os.replace(generation_root, retired_path)
        internal_path.unlink(missing_ok=True)
        if value["framework"] == "laravel":
            pool_path.unlink(missing_ok=True)
            run([
                "/usr/bin/systemctl", "reload",
                f"php{value['php_version']}-fpm.service",
            ])
        run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
        run(["/usr/bin/systemctl", "reload", "caddy.service"])
        probe(f"https://{value['site_host']}", value["site_host"], value, public=True)
        signing_key(instance, value["affinity_generation"])
        terminal = "completed" if action == "complete" else "reversed"
        terminal_value = {
            **value,
            "phase": terminal,
            "stable_weight": 0 if action == "complete" else 100,
            "candidate_weight": 100 if action == "complete" else 0,
        }
        state = safe_target_state(terminal_value, terminal)
        state["phase"] = terminal
        state["stable_health"] = "ready"
        state["candidate_health"] = (
            "ready" if action == "complete" else "unavailable"
        )
        ROOT_STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        atomic_write(
            ROOT_STATE / f"{instance}.json",
            json.dumps(state, sort_keys=True, separators=(",", ":")),
            0o600,
        )
    except BaseException:
        try:
            if retired_path is not None and retired_path.exists():
                os.replace(
                    retired_path,
                    deploy_path / "rollouts" / str(value["generation"]),
                )
            if previous_internal is not None:
                atomic_write(internal_path, previous_internal)
            else:
                internal_path.unlink(missing_ok=True)
            if previous_pool is not None:
                atomic_write(pool_path, previous_pool)
                run([
                    "/usr/bin/systemctl", "reload",
                    f"php{value['php_version']}-fpm.service",
                ])
            if action == "complete":
                replace_current(current, previous_current, value["account"])
                reconcile_processes(instance)
            atomic_write(
                public_path,
                previous_public,
                stat.S_IMODE(previous_public_stat.st_mode),
            )
            os.chown(public_path, previous_public_stat.st_uid, previous_public_stat.st_gid)
            run(["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"])
            run(["/usr/bin/systemctl", "reload", "caddy.service"])
            probe(
                f"https://{value['site_host']}", value["site_host"], value,
                public=True,
            )
            if release_path is not None and release_path.exists():
                shutil.rmtree(release_path)
            if previous_log is None:
                log_path.unlink(missing_ok=True)
            else:
                atomic_write(log_path, previous_log)
            if previous_latest is None:
                latest_path.unlink(missing_ok=True)
            else:
                atomic_write(latest_path, previous_latest)
            if previous_key is not None:
                atomic_write(key_path, previous_key, 0o600)
            else:
                key_path.unlink(missing_ok=True)
            if previous_key_generation is not None:
                atomic_write(key_generation_path, previous_key_generation, 0o600)
            else:
                key_generation_path.unlink(missing_ok=True)
        except BaseException:
            fail("rollout finalization rollback failed")
        fail("rollout finalization failed")
    if retired_path is not None:
        shutil.rmtree(retired_path, ignore_errors=True)
    emit_state(state)


def main() -> None:
    if os.geteuid() != 0:
        fail("rollout helper requires root and one instance")
    if len(sys.argv) == 2:
        main_prepare(sys.argv[1])
    elif len(sys.argv) == 3 and sys.argv[1] == "prepare":
        main_prepare(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "inspect":
        state = root_state(sys.argv[2])
        emit_state({"configured": False} if state is None else state)
    elif len(sys.argv) == 3 and sys.argv[1] == "weights":
        main_weights(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] in {"complete", "reverse"}:
        main_finalize(sys.argv[2])
    else:
        fail("rollout helper action is invalid")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print("rollout helper failed", file=sys.stderr)
        raise SystemExit(1) from None
