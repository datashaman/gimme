#!/usr/bin/python3
"""Restore one registered PostgreSQL database through a verified shadow and bounded swap."""

from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import subprocess  # nosec B404
import sys
import tempfile
from pathlib import Path
from typing import Any


EXPECTED_APPS_ROOT = Path("__GIMME_APPS_ROOT__")
RESTORE_ROOT = EXPECTED_APPS_ROOT / ".gimme" / "restores"
IDENTIFIER = re.compile(r"^[a-z][a-z0-9_]{0,62}$")
DEPLOYMENT = re.compile(r"^[a-z][a-z0-9-]{0,93}$")
REQUEST = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
PHASES = {"pending", "preparing", "shadow_verified", "data_replaced", "completed"}
MAX_STATE_BYTES = 16 * 1024
EXECUTABLES = {
    "createdb": "/usr/bin/createdb",
    "dropdb": "/usr/bin/dropdb",
    "pg_restore": "/usr/bin/pg_restore",
    "psql": "/usr/bin/psql",
}
PUBLIC_FAILURE_CODES = {
    "restore privileged swap failed": "privileged_swap_failed",
    "restore privileged cleanup failed": "privileged_cleanup_failed",
    "restore invocation does not match state": "invocation_mismatch",
}


class RestoreFailure(RuntimeError):
    pass


def derived_identities(database: str, request_id: str) -> tuple[str, str]:
    digest = hashlib.sha256(
        f"gimme-postgres-restore-v1\0{database}\0{request_id}".encode()
    ).hexdigest()[:24]
    return f"gimme_shadow_{digest}", f"gimme_previous_{digest}"


def atomic_write(path: Path, value: dict[str, Any]) -> None:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise


def load_state(path: Path) -> dict[str, Any]:
    root = RESTORE_ROOT.resolve()
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise RestoreFailure("restore state unavailable") from exc
    if root not in resolved.parents or path.is_symlink():
        raise RestoreFailure("restore state boundary invalid")
    details = path.stat()
    if (
        not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid()
        or details.st_mode & (stat.S_IRWXG | stat.S_IRWXO)
        or not 0 < details.st_size <= MAX_STATE_BYTES
    ):
        raise RestoreFailure("restore state protection invalid")
    value = json.loads(path.read_text())
    required = {
        "schema_version", "deployment", "request_id", "database", "role",
        "sha256", "bytes", "phase", "live_oid", "shadow_oid",
    }
    if (
        not isinstance(value, dict) or set(value) != required
        or value.get("schema_version") != 1
        or DEPLOYMENT.fullmatch(str(value.get("deployment"))) is None
        or REQUEST.fullmatch(str(value.get("request_id"))) is None
        or IDENTIFIER.fullmatch(str(value.get("database"))) is None
        or value.get("role") != value.get("database")
        or SHA256.fullmatch(str(value.get("sha256"))) is None
        or not isinstance(value.get("bytes"), int) or isinstance(value.get("bytes"), bool)
        or not 0 <= value["bytes"] <= 512 * 1024 * 1024
        or value.get("phase") not in PHASES
        or (value.get("live_oid") is not None and not isinstance(value["live_oid"], int))
        or (value.get("shadow_oid") is not None and not isinstance(value["shadow_oid"], int))
    ):
        raise RestoreFailure("restore state invalid")
    phase_oids = {
        "pending": (False, False),
        "preparing": (True, False),
        "shadow_verified": (True, True),
        "data_replaced": (True, True),
        "completed": (True, True),
    }
    live_required, shadow_required = phase_oids[value["phase"]]
    if (
        (value["live_oid"] is not None) != live_required
        or (value["shadow_oid"] is not None) != shadow_required
        or (value["live_oid"] is not None and value["live_oid"] <= 0)
        or (value["shadow_oid"] is not None and value["shadow_oid"] <= 0)
    ):
        raise RestoreFailure("restore state phase invalid")
    expected = root / value["deployment"] / f'{value["request_id"]}.json'
    if resolved != expected:
        raise RestoreFailure("restore state identity invalid")
    return value


def validate_artifact_path(state_path: Path, artifact: Path, state: dict[str, Any]) -> None:
    try:
        state_parent = state_path.parent.resolve(strict=True)
        artifact_parent = artifact.parent.resolve(strict=True)
    except OSError as exc:
        raise RestoreFailure("restore artifact boundary invalid") from exc
    if (
        artifact.is_symlink()
        or artifact_parent != state_parent
        or artifact.name != f'{state["request_id"]}.dump'
    ):
        raise RestoreFailure("restore artifact boundary invalid")


def artifact_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def run(arguments: list[str]) -> None:
    if not arguments or arguments[0] not in EXECUTABLES:
        raise RestoreFailure("restore executable invalid")
    try:
        subprocess.run(  # nosec B603
            [EXECUTABLES[arguments[0]], *arguments[1:]], check=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=1800,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise RestoreFailure("restore command failed") from exc


def query(database: str, statement: str, variables: dict[str, str]) -> str:
    arguments = [
        EXECUTABLES["psql"], "--no-psqlrc", "-Atq", "-v", "ON_ERROR_STOP=1",
        *[item for key, value in sorted(variables.items()) for item in ("-v", f"{key}={value}")],
        "-d", database,
    ]
    try:
        result = subprocess.run(  # nosec B603
            arguments, input=statement.encode(), check=True, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise RestoreFailure("restore query failed") from exc
    if len(result.stdout) > 256:
        raise RestoreFailure("restore query output invalid")
    return result.stdout.decode("ascii", "strict").strip()


def database_oid(name: str) -> int | None:
    output = query(
        "postgres", "SELECT oid FROM pg_database WHERE datname = :'name';\n", {"name": name}
    )
    if output == "":
        return None
    if not output.isdigit() or int(output) <= 0:
        raise RestoreFailure("restore database observation invalid")
    return int(output)


def privileged_action(action: str, state: dict[str, Any]) -> None:
    try:
        subprocess.run(  # nosec B603
            [
                "/usr/bin/sudo", "-n",
                "/usr/local/sbin/gimme-postgres-restore-swap",
                action, state["deployment"], state["request_id"],
            ],
            check=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=300,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise RestoreFailure(f"restore privileged {action} failed") from exc


def prepare(state_path: Path, artifact: Path) -> None:
    state = load_state(state_path)
    validate_artifact_path(state_path, artifact, state)
    if state["phase"] in {"shadow_verified", "data_replaced", "completed"}:
        return
    details = artifact.stat()
    if (
        not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid()
        or details.st_mode & (stat.S_IRWXG | stat.S_IRWXO)
        or details.st_size != state["bytes"]
        or artifact_sha256(artifact) != state["sha256"]
    ):
        raise RestoreFailure("restore artifact invalid")
    run(["pg_restore", "--list", str(artifact)])
    shadow, previous = derived_identities(state["database"], state["request_id"])
    live_oid = database_oid(state["database"])
    if live_oid is None or database_oid(previous) is not None:
        raise RestoreFailure("restore destination state invalid")
    if state["phase"] == "pending":
        if database_oid(shadow) is not None:
            raise RestoreFailure("restore shadow already exists")
        state.update({"phase": "preparing", "live_oid": live_oid})
        atomic_write(state_path, state)
    elif state["live_oid"] != live_oid:
        raise RestoreFailure("restore destination identity changed")
    if database_oid(shadow) is not None:
        run(["dropdb", shadow])
    run(["createdb", "--owner", state["role"], shadow])
    try:
        run([
            "pg_restore", "--exit-on-error", "--no-owner", "--no-privileges",
            "--role", state["role"], "--dbname", shadow, str(artifact),
        ])
        shadow_oid = database_oid(shadow)
        if shadow_oid is None or query(shadow, "SELECT 1;\n", {}) != "1":
            raise RestoreFailure("restore shadow verification failed")
    except Exception:
        run(["dropdb", "--if-exists", shadow])
        raise
    state.update({"phase": "shadow_verified", "shadow_oid": shadow_oid})
    atomic_write(state_path, state)


def swap(state_path: Path) -> None:
    state = load_state(state_path)
    if state["phase"] in {"data_replaced", "completed"}:
        return
    if state["phase"] != "shadow_verified":
        raise RestoreFailure("restore shadow is not verified")
    database = state["database"]
    shadow, previous = derived_identities(database, state["request_id"])
    live_oid, shadow_oid = state["live_oid"], state["shadow_oid"]
    observed = {
        "live": database_oid(database),
        "shadow": database_oid(shadow),
        "previous": database_oid(previous),
    }
    if observed == {"live": shadow_oid, "shadow": None, "previous": live_oid}:
        state["phase"] = "data_replaced"
        atomic_write(state_path, state)
        return
    if observed not in (
        {"live": live_oid, "shadow": shadow_oid, "previous": None},
        {"live": None, "shadow": shadow_oid, "previous": live_oid},
    ):
        raise RestoreFailure("restore swap state ambiguous")
    privileged_action("swap", state)
    if database_oid(database) != shadow_oid or database_oid(previous) != live_oid:
        raise RestoreFailure("restore swap verification failed")
    state["phase"] = "data_replaced"
    atomic_write(state_path, state)


def cleanup(state_path: Path, artifact: Path) -> None:
    state = load_state(state_path)
    validate_artifact_path(state_path, artifact, state)
    if state["phase"] == "completed":
        artifact.unlink(missing_ok=True)
        return
    if state["phase"] != "data_replaced":
        raise RestoreFailure("restore data is not replaced")
    database = state["database"]
    _shadow, previous = derived_identities(database, state["request_id"])
    if database_oid(database) != state["shadow_oid"] or database_oid(previous) != state["live_oid"]:
        raise RestoreFailure("restore cleanup state ambiguous")
    privileged_action("cleanup", state)
    if database_oid(database) != state["shadow_oid"] or database_oid(previous) is not None:
        raise RestoreFailure("restore cleanup verification failed")
    state["phase"] = "completed"
    atomic_write(state_path, state)
    artifact.unlink(missing_ok=True)


def main() -> None:
    if len(sys.argv) != 7 or sys.argv[1] not in {"prepare", "swap", "cleanup"}:
        raise RestoreFailure("restore action invalid")
    action, state_value, artifact_value, expected_database, expected_sha256, bytes_value = (
        sys.argv[1:]
    )
    state_path, artifact = Path(state_value), Path(artifact_value)
    if (
        not state_path.is_absolute()
        or not artifact.is_absolute()
        or IDENTIFIER.fullmatch(expected_database) is None
        or SHA256.fullmatch(expected_sha256) is None
        or not bytes_value.isdigit()
        or not 0 <= int(bytes_value) <= 512 * 1024 * 1024
    ):
        raise RestoreFailure("restore path invalid")
    state = load_state(state_path)
    if (
        state["database"] != expected_database
        or state["sha256"] != expected_sha256
        or state["bytes"] != int(bytes_value)
    ):
        raise RestoreFailure("restore invocation does not match state")
    {"prepare": prepare, "swap": lambda s, _a: swap(s), "cleanup": cleanup}[action](
        state_path, artifact
    )
    print(f"GIMME_POSTGRES_RESTORE|{load_state(state_path)['phase']}")


if __name__ == "__main__":
    try:
        main()
    except RestoreFailure as exc:
        code = PUBLIC_FAILURE_CODES.get(str(exc), "restore_failed")
        print(f"GIMME_POSTGRES_RESTORE_FAILED|{code}", file=sys.stderr)
        raise SystemExit(1) from None
    except (OSError, ValueError, UnicodeError, json.JSONDecodeError):
        print("GIMME_POSTGRES_RESTORE_FAILED|restore_failed", file=sys.stderr)
        raise SystemExit(1) from None
