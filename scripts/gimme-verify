#!/usr/bin/env bash

set -euo pipefail

report_failure() {
    local exit_code=$?
    printf 'verification failed (exit %d) at line %d: %s\n' \
        "$exit_code" "${BASH_LINENO[0]}" "$BASH_COMMAND" >&2
    exit "$exit_code"
}
trap report_failure ERR

repository_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repository_root"

uv run ruff check .
uv run ruff check --stdin-filename gimme-provision-stack - < scripts/gimme-provision-stack
uv run ruff check --stdin-filename gimme-provision-processes - < scripts/gimme-provision-processes
uv run ruff check --stdin-filename gimme-recovery-maintenance - < scripts/gimme-recovery-maintenance
uv run ruff check --stdin-filename gimme-capture-valkey - < scripts/gimme-capture-valkey
uv run ruff check --stdin-filename gimme-restore-postgres - < scripts/gimme-restore-postgres
uv run bandit -q -r src
uv run bandit -q scripts/gimme-provision-stack scripts/gimme-provision-processes \
    scripts/gimme-recovery-maintenance scripts/gimme-capture-valkey scripts/gimme-restore-postgres
uv export --frozen --no-dev --no-emit-project | uv run pip-audit -r /dev/stdin
uv run pytest -q
vendor/bin/phpstan analyse deploy.php deploy --no-progress --level=5

while IFS= read -r php_file; do
    php -l "$php_file"
done < <(find deploy.php deploy -type f -name '*.php' -print | sort)

composer audit --locked --no-interaction
git diff --check
git diff --cached --check
if git rev-parse --verify HEAD^ >/dev/null 2>&1; then
    git diff --check HEAD^ HEAD
fi
