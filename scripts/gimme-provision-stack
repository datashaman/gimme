#!/usr/bin/python3
# GIMME_POLICY_ID=__GIMME_POLICY_ID__
"""Reconcile Gimme's validated desired stack as root.

Installed root-owned at /usr/local/sbin/gimme-provision-stack. The sudo rule permits
only this argument-free executable; desired state is read from one fixed path.
"""

from __future__ import annotations

import json
import os
import pwd
import re
import shutil
import stat
# Subprocess calls use fixed executable argv vectors and never invoke a shell.
import subprocess  # nosec B404
import sys
import tempfile
from ipaddress import ip_address
from pathlib import Path
from typing import Any


STATE_PATH = Path("__GIMME_STATE_PATH__")
EXPECTED_APPS_ROOT = STATE_PATH.parents[1]
APP_NAME = re.compile(r"^[a-z][a-z0-9-]{0,47}$")
INSTANCE_NAME = re.compile(r"^[a-z][a-z0-9-]{0,93}$")
ENVIRONMENT_NAME = re.compile(r"^[a-z][a-z0-9-]{0,31}$")
MDNS_NAME = re.compile(r"^[a-z][a-z0-9-]{0,62}$")
UNIX_USER = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_-]{0,31}$")
PACKAGE_NAME = re.compile(r"^[a-z0-9][a-z0-9+.-]{0,79}$")
RELATIVE_DIRECTORY = re.compile(r"^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*$")
DNS_NAME = re.compile(
    r"^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)*"
    r"[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
)
ALLOWED_SERVICES = {"avahi-daemon", "caddy", "postgresql", "valkey-server"}
ALLOWED_FRAMEWORKS = {"common", "laravel", "symfony", "wordpress", "static"}
MAX_STATE_BYTES = 256 * 1024
AVAHI_BEGIN = "# BEGIN GIMME MANAGED HOSTS"
AVAHI_END = "# END GIMME MANAGED HOSTS"
CADDY_IMPORT = "import /etc/caddy/gimme/*.caddy"
CADDY_ROOT = Path(
    "/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt"
)
ALLOWED_PACKAGES = set(json.loads("__GIMME_ALLOWED_PACKAGES_JSON__"))
EXPECTED_HOSTNAME = "__GIMME_HOSTNAME__"
EXPECTED_MDNS_NAME = "__GIMME_MDNS_NAME__"
EXECUTABLES = {
    "apt-get": "/usr/bin/apt-get",
    "caddy": "/usr/bin/caddy",
    "env": "/usr/bin/env",
    "getent": "/usr/bin/getent",
    "hostname": "/usr/bin/hostname",
    "hostnamectl": "/usr/bin/hostnamectl",
    "setfacl": "/usr/bin/setfacl",
    "systemctl": "/usr/bin/systemctl",
}


def fail(message: str) -> None:
    raise RuntimeError(message)


def fixed_command(command: list[str]) -> list[str]:
    if not command or command[0] not in EXECUTABLES:
        fail("privileged helper attempted an unexpected executable")
    return [EXECUTABLES[command[0]], *command[1:]]


def run(command: list[str], *, capture: bool = False) -> subprocess.CompletedProcess[str]:
    command = fixed_command(command)
    print("+ " + " ".join(command), flush=True)
    # Callers construct validated argv vectors.
    return subprocess.run(  # nosec B603
        command,
        check=True,
        text=True,
        capture_output=capture,
    )


def succeeds(command: list[str]) -> bool:
    command = fixed_command(command)
    # Callers construct validated argv vectors.
    return subprocess.run(  # nosec B603
        command,
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def attempt(command: list[str]) -> None:
    command = fixed_command(command)
    print("+ " + " ".join(command), flush=True)
    # Callers construct validated argv vectors.
    subprocess.run(  # nosec B603
        command, check=False
    )


def package_is_installed(package: str) -> bool:
    # Package is validated against the installed helper's fixed allowlist.
    result = subprocess.run(  # nosec B603
        ["/usr/bin/dpkg-query", "-W", "-f=${Status}", package],
        check=False,
        text=True,
        capture_output=True,
    )
    return result.returncode == 0 and result.stdout == "install ok installed"


def atomic_write(path: Path, content: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise


def require_string(value: Any, name: str, pattern: re.Pattern[str]) -> str:
    if not isinstance(value, str) or pattern.fullmatch(value) is None:
        fail(f"invalid {name}")
    return value


def require_unique_names(
    value: Any,
    name: str,
    pattern: re.Pattern[str],
    *,
    allow_empty: bool = False,
) -> list[str]:
    if not isinstance(value, list) or (not value and not allow_empty):
        fail(f"{name} must be a list" + ("" if allow_empty else " with at least one item"))
    if not all(isinstance(item, str) and pattern.fullmatch(item) for item in value):
        fail(f"{name} contains an invalid value")
    if len(value) != len(set(value)):
        fail(f"{name} contains duplicates")
    return value


def validate_endpoint(value: Any) -> str:
    if not isinstance(value, str):
        fail("invalid host endpoint")
    try:
        ip_address(value)
    except ValueError:
        if DNS_NAME.fullmatch(value) is None:
            fail("invalid host endpoint")
    return value


def validate_ipv4_address(value: str) -> str:
    try:
        address = ip_address(value)
    except ValueError:
        fail("resolved host endpoint is not an IP address")
    if address.version != 4:
        fail("resolved host endpoint is not IPv4")
    return str(address)


def validate_apps(value: Any) -> dict[str, dict[str, Any]]:
    if not isinstance(value, dict):
        fail("apps must be an object")
    validated: dict[str, dict[str, Any]] = {}
    for name, definition in value.items():
        require_string(name, "application name", APP_NAME)
        if not isinstance(definition, dict):
            fail(f"invalid application definition for {name}")
        framework = definition.get("framework", "common")
        if framework not in ALLOWED_FRAMEWORKS:
            fail(f"invalid framework for {name}")
        output_dir = ""
        if framework == "static":
            frontend = definition.get("frontend")
            if not isinstance(frontend, dict):
                fail(f"static application {name} requires frontend configuration")
            output_dir = frontend.get("output_dir", "dist")
            if not isinstance(output_dir, str) or not output_dir:
                fail(f"invalid frontend output directory for {name}")
            parts = Path(output_dir).parts
            if (
                Path(output_dir).is_absolute()
                or ".." in parts
                or "." in parts
                or output_dir.startswith("-")
                or RELATIVE_DIRECTORY.fullmatch(output_dir) is None
            ):
                fail(f"unsafe frontend output directory for {name}")
        validated[name] = {"framework": framework, "output_dir": output_dir}
    return validated


def validate_sites(value: Any) -> dict[str, dict[str, Any]]:
    if not isinstance(value, dict):
        fail("sites must be an object")
    validated: dict[str, dict[str, Any]] = {}
    root = EXPECTED_APPS_ROOT.resolve()
    for instance, definition in value.items():
        require_string(instance, "site instance", INSTANCE_NAME)
        if not isinstance(definition, dict) or set(definition) != {
            "deployment",
            "framework",
            "site_host",
            "document_root",
        }:
            fail(f"invalid site definition for {instance}")
        deployment = require_string(
            definition["deployment"], "deployment name", INSTANCE_NAME
        )
        framework = definition["framework"]
        if framework not in ALLOWED_FRAMEWORKS:
            fail(f"invalid framework for {instance}")
        site_host = require_string(definition["site_host"], "site hostname", DNS_NAME)
        if not isinstance(definition["document_root"], str):
            fail(f"invalid document root for {instance}")
        document_root = Path(definition["document_root"])
        if not document_root.is_absolute() or ".." in document_root.parts:
            fail(f"invalid document root for {instance}")
        resolved_parent = document_root.parent.resolve(strict=False)
        if resolved_parent != root and not resolved_parent.is_relative_to(root):
            fail(f"document root escapes applications root for {instance}")
        validated[instance] = {
            "deployment": deployment,
            "framework": framework,
            "site_host": site_host,
            "document_root": document_root,
        }
    return validated


def render_caddy_site(
    name: str,
    mdns_name: str,
    document_root: Path,
    framework: str,
    site_host: str | None = None,
    internal_tls: bool = True,
) -> str:
    site_host = site_host or f"{name}.{mdns_name}.local"
    php_handler = (
        ""
        if framework == "static"
        else (
            "    php_fastcgi unix//run/php/php-fpm.sock {\n"
            "        resolve_root_symlink\n"
            "    }\n"
        )
    )
    tls = "    tls internal\n" if internal_tls else ""
    return (
        f"{site_host} {{\n"
        f"{tls}"
        f"    root * {json.dumps(str(document_root))}\n"
        "    encode zstd gzip\n"
        f"{php_handler}"
        "    file_server {\n"
        "        hide .git* .env* .hg* .svn\n"
        "    }\n"
        "}\n"
    )


def render_mdns_unit(name: str, site_host: str, address: str) -> str:
    require_string(name, "site instance", INSTANCE_NAME)
    if DNS_NAME.fullmatch(site_host) is None:
        fail("invalid application site hostname")
    address = validate_ipv4_address(address)
    return (
        "[Unit]\n"
        f"Description=Publish mDNS alias {site_host}\n"
        "After=avahi-daemon.service network-online.target\n"
        "Requires=avahi-daemon.service\n\n"
        "[Service]\n"
        "Type=simple\n"
        f"ExecStart=/usr/bin/avahi-publish -a -R {site_host} {address}\n"
        "Restart=on-failure\n"
        "RestartSec=2\n"
        "NoNewPrivileges=true\n"
        "PrivateTmp=true\n"
        "ProtectSystem=strict\n"
        "ProtectHome=true\n"
        "CapabilityBoundingSet=\n"
        "RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6\n"
        "RestrictSUIDSGID=true\n\n"
        "[Install]\n"
        "WantedBy=multi-user.target\n"
    )


def load_state(sudo_user: str, sudo_uid: int) -> dict[str, Any]:
    if STATE_PATH.is_symlink():
        fail("desired-state file must not be a symlink")
    details = STATE_PATH.stat()
    if not stat.S_ISREG(details.st_mode) or details.st_uid != sudo_uid:
        fail("desired-state file must be a regular file owned by the sudo caller")
    if details.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        fail("desired-state file must not be group or world accessible")
    if details.st_size > MAX_STATE_BYTES:
        fail("desired-state file is too large")
    state = json.loads(STATE_PATH.read_text())
    if not isinstance(state, dict) or state.get("version") != 1:
        fail("unsupported desired-state document")
    if state.get("package_manager") != "apt":
        fail("only apt is supported")
    if state.get("mode", "stack") not in {"stack", "sites"}:
        fail("unsupported reconciliation mode")
    if state.get("remote_user") != sudo_user:
        fail("desired-state remote_user does not match the sudo caller")
    if state.get("apps_root") != str(EXPECTED_APPS_ROOT):
        fail("desired-state apps_root does not match the installed helper")
    return state


def reconcile() -> None:
    if os.geteuid() != 0:
        fail("gimme-provision-stack must run as root")
    if len(sys.argv) != 1:
        fail("gimme-provision-stack accepts no arguments")
    sudo_user = require_string(os.environ.get("SUDO_USER"), "SUDO_USER", UNIX_USER)
    account = pwd.getpwnam(sudo_user)
    state = load_state(sudo_user, account.pw_uid)
    mode = state.get("mode", "stack")

    packages = require_unique_names(state.get("packages"), "packages", PACKAGE_NAME)
    disallowed_packages = sorted(set(packages) - ALLOWED_PACKAGES)
    if disallowed_packages:
        fail("packages are not allowlisted: " + ", ".join(disallowed_packages))
    services = require_unique_names(
        state.get("services"), "services", PACKAGE_NAME, allow_empty=True
    )
    disallowed_services = sorted(set(services) - ALLOWED_SERVICES)
    if disallowed_services:
        fail("services are not allowlisted: " + ", ".join(disallowed_services))
    endpoint = validate_endpoint(state.get("hostname"))
    mdns_name = require_string(state.get("mdns_name"), "mdns_name", MDNS_NAME)
    network_mode = state.get("network_mode", "local_mdns")
    if network_mode not in {"local_mdns", "public_dns"}:
        fail("unsupported network mode")
    if endpoint != EXPECTED_HOSTNAME or mdns_name != EXPECTED_MDNS_NAME:
        fail("desired-state host identity does not match the installed helper")
    sites = validate_sites(state.get("sites"))

    missing = [package for package in packages if not package_is_installed(package)]
    if mode == "sites" and missing:
        fail("sites-only reconciliation requires the provisioned package stack")
    if mode == "stack" and missing:
        run(["apt-get", "update"])
        run(
            [
                "env",
                "DEBIAN_FRONTEND=noninteractive",
                "apt-get",
                "--no-install-recommends",
                "install",
                "-y",
                *missing,
            ]
        )

    for service in services:
        if mode == "sites" and (
            not succeeds(["systemctl", "is-enabled", "--quiet", service])
            or not succeeds(["systemctl", "is-active", "--quiet", service])
        ):
            fail("sites-only reconciliation requires active configured services")
        if not succeeds(["systemctl", "is-enabled", "--quiet", service]) or not succeeds(
            ["systemctl", "is-active", "--quiet", service]
        ):
            run(["systemctl", "enable", "--now", service])

    current_hostname = run(["hostname"], capture=True).stdout.strip()
    if mode == "sites" and current_hostname != mdns_name:
        fail("sites-only reconciliation requires the configured hostname")
    if mode == "stack" and current_hostname != mdns_name:
        run(["hostnamectl", "set-hostname", mdns_name])
        if network_mode == "local_mdns":
            run(["systemctl", "restart", "avahi-daemon"])

    EXPECTED_APPS_ROOT.mkdir(parents=True, exist_ok=True)
    # Group traversal is intentional and further narrowed by explicit ACLs below.
    os.chmod(EXPECTED_APPS_ROOT, 0o750)  # nosec B103
    os.chown(EXPECTED_APPS_ROOT, account.pw_uid, account.pw_gid)

    caddy_directory = Path("/etc/caddy/gimme")
    caddy_directory.mkdir(parents=True, exist_ok=True)
    desired_site_files: set[Path] = set()
    desired_mdns_units: set[Path] = set()
    address = ""
    if network_mode == "local_mdns" and sites:
        address_output = run(["getent", "ahostsv4", endpoint], capture=True).stdout
        address = address_output.split()[0] if address_output.split() else ""
        if not address:
            fail("could not resolve the configured host endpoint to IPv4")
        address = validate_ipv4_address(address)
    for name, definition in sorted(sites.items()):
        framework = definition["framework"]
        document_root = definition["document_root"]
        site_host = definition["site_host"]
        site = render_caddy_site(
            name,
            mdns_name,
            document_root,
            framework,
            site_host=site_host,
            internal_tls=network_mode == "local_mdns",
        )
        site_path = caddy_directory / f"{name}.caddy"
        atomic_write(site_path, site)
        desired_site_files.add(site_path)
        if network_mode == "local_mdns":
            unit_path = Path(f"/etc/systemd/system/gimme-mdns-{name}.service")
            unit = render_mdns_unit(name, site_host, address)
            atomic_write(unit_path, unit)
            desired_mdns_units.add(unit_path)

    for site_path in caddy_directory.glob("*.caddy"):
        if site_path not in desired_site_files:
            site_path.unlink()

    for unit_path in Path("/etc/systemd/system").glob("gimme-mdns-*.service"):
        if unit_path not in desired_mdns_units:
            attempt(["systemctl", "disable", "--now", unit_path.name])
            unit_path.unlink()

    caddyfile = Path("/etc/caddy/Caddyfile")
    caddy_content = caddyfile.read_text()
    if CADDY_IMPORT not in caddy_content.splitlines():
        atomic_write(caddyfile, caddy_content.rstrip() + f"\n\n{CADDY_IMPORT}\n")

    # Static Avahi host mappings publish a reverse record and collide when aliases
    # share the machine's own address. Remove Gimme's legacy block; persistent
    # avahi-publish services below use -R/--no-reverse instead.
    avahi_hosts = Path("/etc/avahi/hosts")
    existing = avahi_hosts.read_text() if avahi_hosts.exists() else ""
    managed = re.compile(
        rf"\n?{re.escape(AVAHI_BEGIN)}.*?{re.escape(AVAHI_END)}\n?", re.DOTALL
    )
    unmanaged = managed.sub("\n", existing).rstrip()
    atomic_write(avahi_hosts, unmanaged + ("\n" if unmanaged else ""))

    run(
        [
            "setfacl",
            "-m",
            "u:caddy:rx,u:www-data:rx",
            str(EXPECTED_APPS_ROOT),
        ]
    )
    run(["caddy", "validate", "--config", str(caddyfile), "--adapter", "caddyfile"])
    run(["systemctl", "reload", "caddy"])
    if network_mode == "local_mdns":
        run(["systemctl", "restart", "avahi-daemon"])
    run(["systemctl", "daemon-reload"])
    for unit_path in sorted(desired_mdns_units):
        run(["systemctl", "enable", unit_path.name])
        run(["systemctl", "restart", unit_path.name])

    if network_mode == "local_mdns" and CADDY_ROOT.is_file():
        exported_root = EXPECTED_APPS_ROOT / ".caddy-local-root.crt"
        shutil.copyfile(CADDY_ROOT, exported_root)
        os.chmod(exported_root, 0o644)
        os.chown(exported_root, account.pw_uid, account.pw_gid)


if __name__ == "__main__":
    try:
        reconcile()
    except (OSError, ValueError, RuntimeError, json.JSONDecodeError) as error:
        print(f"gimme-provision-stack: {error}", file=sys.stderr)
        raise SystemExit(1) from error
