{
  "schema_version": 4,
  "provider_accounts": {
    "main": {
      "provider": "aws",
      "account_id": "123456789012",
      "inspection_role_arn": "arn:aws:iam::123456789012:role/gimme-inspect",
      "resolver_role_arn": "arn:aws:iam::123456789012:role/gimme-resolve"
    }
  },
  "secret_stores": {
    "local-sops": {"provider": "sops"},
    "workload-secrets": {
      "provider": "aws_secrets_manager",
      "provider_account": "main",
      "region": "us-east-1",
      "prefix": "gimme/workload"
    }
  },
  "aws_networks": {
    "primary": {
      "provider_account": "main",
      "region": "us-east-1",
      "vpc_id": "vpc-0123456789abcdef0",
      "private_subnet_ids": ["subnet-0123456789abcdef0", "subnet-0123456789abcdef1"]
    }
  },
  "backup_destinations": {
    "primary": {
      "provider": "s3_compatible",
      "bucket": "gimme-example-backups",
      "region": "us-east-1",
      "endpoint": null,
      "addressing": "virtual_hosted",
      "encryption": {"method": "aes256"},
      "auth": {"mode": "ambient"}
    }
  },
  "targets": {
    "devbox": {
      "host_alias": "devbox",
      "bootstrap_hostname": "192.0.2.10",
      "hostname": "devbox.local",
      "system_hostname": "devbox",
      "remote_user": "deployer",
      "apps_root": "/srv/gimme/apps",
      "keep_releases": 5,
      "network": {
        "mode": "local_mdns",
        "mdns_name": "devbox",
        "expected_addresses": []
      },
      "stack": {
        "package_manager": "apt",
        "packages": [
          "acl",
          "git",
          "unzip",
          "avahi-daemon",
          "avahi-utils",
          "software-properties-common",
          "mise",
          "caddy",
          "nodejs",
          "npm",
          "postgresql",
          "python3",
          "valkey-server",
          "valkey-tools",
          "php-cli",
          "php-fpm",
          "php-gd",
          "php-pgsql",
          "php-curl",
          "php-mbstring",
          "php-xml",
          "php-zip",
          "php-intl",
          "php-bcmath",
          "php-redis",
          "composer"
        ],
        "services": ["avahi-daemon", "caddy", "postgresql", "valkey-server"]
      },
      "runtimes": {
        "mise_version": "2026.9.9"
      }
    },
    "adminbox": {
      "host_alias": "adminbox",
      "bootstrap_hostname": "192.0.2.20",
      "hostname": "adminbox.local",
      "system_hostname": "adminbox",
      "remote_user": "deployer",
      "apps_root": "/srv/gimme/apps",
      "keep_releases": 5,
      "role": "administration",
      "network": {
        "mode": "local_mdns",
        "mdns_name": "adminbox",
        "expected_addresses": []
      },
      "stack": {
        "package_manager": "apt",
        "packages": ["acl", "git"],
        "services": []
      },
      "runtimes": {
        "mise_version": null
      }
    }
  },
  "applications": {
    "example": {
      "repository": "git@github.com:example/example.git",
      "framework": "laravel",
      "frontend": {
        "package_manager": "npm",
        "build_script": "build",
        "output_dir": "public/build"
      },
      "artisan": {
        "allowed_commands": ["about", "migrate", "migrate:status", "queue:restart"]
      },
      "default_health": {
        "name": "framework",
        "phases": ["candidate", "live"],
        "path": "/up",
        "expected_status": 200,
        "attempts": 10,
        "delay_seconds": 2,
        "timeout_seconds": 5
      },
      "health_probes": [
        {
          "name": "homepage",
          "phases": ["live"],
          "path": "/",
          "expected_status": 302,
          "attempts": 3,
          "delay_seconds": 1,
          "timeout_seconds": 5
        }
      ],
      "php_extensions": ["bcmath", "curl", "gd", "intl", "mbstring", "pdo_pgsql", "redis", "xml", "zip"]
    }
  },
  "resources": {
    "devbox-postgres": {
      "target": "devbox",
      "kind": "postgres",
      "provider": "target_local",
      "version": "17.2"
    },
    "devbox-valkey": {
      "target": "devbox",
      "kind": "valkey",
      "provider": "target_local",
      "version": "8.0.1"
    },
    "example-rds-postgres": {
      "kind": "postgres",
      "provider": "aws_rds_postgres",
      "aws_network": "primary",
      "administration_target": "adminbox",
      "engine_version": "17.2",
      "instance_class": "db.t3.medium",
      "allocated_storage_gb": 20,
      "administration_security_group_id": "sg-0123456789abcdef0",
      "deployment_security_group_ids": {"devbox": "sg-0123456789abcdef1"},
      "workload_secret_store": "workload-secrets",
      "retain_on_removal": true
    }
  },
  "deployments": {
    "example-local": {
      "application": "example",
      "target": "devbox",
      "stage": "local",
      "source": {"kind": "branch", "ref": "main"},
      "app_env": "local",
      "app_debug": true,
      "domain": null,
      "health": "inherit",
      "workers": null,
      "scheduler": null,
      "variables": {"LOG_CHANNEL": "stack"},
      "secrets": {
        "MAIL_PASSWORD": {
          "store": "local-sops",
          "secret": "example-local",
          "field": "MAIL_PASSWORD"
        }
      },
      "runtimes": {
        "php": {"provider": "system", "version": "8.4.1"},
        "composer": {"provider": "system", "version": "2.8.4"},
        "node": {"provider": "mise", "version": "22.12.0"},
        "npm": {"provider": "bundled", "version": "10.9.0"}
      },
      "resources": {
        "database": "devbox-postgres",
        "cache": "devbox-valkey"
      },
      "recovery": {
        "destination": "primary"
      },
      "placement": {
        "instance": "example-local",
        "relative_path": "deployments/example-local",
        "database_identifier": "gimme_example_local",
        "cache_prefix": "gimme:example-local:",
        "site_host": "example-local.devbox.local"
      }
    }
  }
}
