{
  "apps": {
    "example": {
      "framework": "laravel",
      "artisan": {
        "allowed_commands": [
          "about",
          "cache:clear",
          "config:cache",
          "config:clear",
          "horizon:continue",
          "horizon:pause",
          "horizon:status",
          "horizon:terminate",
          "migrate",
          "migrate:status",
          "optimize",
          "optimize:clear",
          "queue:restart",
          "route:cache",
          "route:clear",
          "schedule:list",
          "storage:link",
          "view:cache",
          "view:clear"
        ]
      },
      "health": {
        "path": "/up",
        "expected_status": 200,
        "attempts": 10,
        "delay_seconds": 2,
        "timeout_seconds": 5
      },
      "frontend": {
        "build_script": "build",
        "output_dir": "public/build",
        "package_manager": "npm"
      },
      "repository": "git@github.com:example/example.git",
      "environments": {
        "default": {
          "branch": "main",
          "health": "inherit",
          "workers": {
            "driver": "horizon",
            "enabled": true,
            "stop_wait_seconds": 3600
          },
          "scheduler": {
            "enabled": true
          }
        },
        "feature-example": {
          "branch": "feature/example",
          "health": "inherit",
          "workers": null,
          "scheduler": null
        }
      }
    }
  }
}
